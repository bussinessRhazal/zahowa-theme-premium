<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-theme="light" data-animations="{{ settings.animations_enable }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <script>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem('zahowa-theme'); } catch (e) {}
        if (theme !== 'dark' && theme !== 'light') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Jost:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    >
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        "logo": "{% if settings.logo != blank %}{{ settings.logo | image_url: width: 600 }}{% else %}{{ shop.url }}{% endif %}",
        "sameAs": [
          {% if settings.social_instagram != blank %}{{ settings.social_instagram | json }}{% endif %}
          {% if settings.social_facebook != blank %},{{ settings.social_facebook | json }}{% endif %}
          {% if settings.social_tiktok != blank %},{{ settings.social_tiktok | json }}{% endif %}
          {% if settings.social_whatsapp != blank %},{{ settings.social_whatsapp | json }}{% endif %}
        ]
      }
    </script>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <noscript>
      <style>
        [data-reveal] { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    <style>
      :root,
      [data-theme="light"] {
        color-scheme: light;
        --color-bg: {{ settings.color_bg }};
        --color-bg-alt: {{ settings.color_bg_alt }};
        --color-bg-card: {{ settings.color_bg_card }};
        --color-ink: {{ settings.color_ink }};
        --color-ink-soft: {{ settings.color_ink_soft }};
        --color-gold: {{ settings.color_gold }};
        --color-gold-dark: {{ settings.color_gold_dark }};
        --color-accent: {{ settings.color_accent }};
        --color-border: {{ settings.color_border }};
        --color-button-bg: {{ settings.color_button_bg }};
        --color-button-text: {{ settings.color_button_text }};
        --color-error: {{ settings.color_error }};
        --color-success: {{ settings.color_success }};
      }

      [data-theme="dark"] {
        color-scheme: dark;
        --color-bg: {{ settings.color_dark_bg }};
        --color-bg-alt: {{ settings.color_dark_bg_alt }};
        --color-bg-card: {{ settings.color_dark_bg_card }};
        --color-ink: {{ settings.color_dark_ink }};
        --color-ink-soft: {{ settings.color_dark_ink_soft }};
        --color-gold: {{ settings.color_dark_gold }};
        --color-gold-dark: {{ settings.color_dark_gold_dark }};
        --color-accent: {{ settings.color_dark_accent }};
        --color-border: {{ settings.color_dark_border }};
        --color-button-bg: {{ settings.color_dark_button_bg }};
        --color-button-text: {{ settings.color_dark_button_text }};
        --color-error: #e57373;
        --color-success: #81c784;
      }

      :root {
        --font-display: {{ settings.font_display.family }}, "Cormorant Garamond", Georgia, serif;
        --font-body: {{ settings.font_body.family }}, "Jost", system-ui, sans-serif;
        --base-font-size: {{ settings.base_font_size }}px;
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --page-width: {{ settings.page_width }}px;
        --section-spacing: {{ settings.section_spacing }}px;
        --radius: {{ settings.border_radius }}px;
        --header-logo-width: {{ settings.logo_width }}px;
        --marquee-speed: {{ settings.marquee_speed }}s;
        --animations-enabled: {{ settings.animations_enable }};
      }
    </style>
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}-{{ template.suffix | handle }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% section 'cart-drawer' %}

    {%- if template.name == 'product' -%}
      <div class="sticky-atc" data-sticky-atc hidden>
        <div class="sticky-atc__inner">
          <p class="sticky-atc__title" data-sticky-atc-title>{{ product.title }}</p>
          <span class="sticky-atc__price" data-sticky-atc-price>{{ product.selected_or_first_available_variant.price | money }}</span>
          <button type="button" class="btn btn--primary" data-sticky-atc-add>
            {% render 'icon', name: 'cart' %}
            {{ 'sections.main_product.add_to_cart' | t }}
          </button>
        </div>
      </div>
    {%- endif -%}

    <div class="toast" data-toast role="status" aria-live="polite"></div>
  </body>
</html>
