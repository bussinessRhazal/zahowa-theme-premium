/* ============================================================
   Zahowa — Design System
   ============================================================ */

*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: var(--font-body);
  font-size: var(--base-font-size);
  line-height: 1.6;
  color: var(--color-ink);
  background-color: var(--color-bg);
  -webkit-font-smoothing: antialiased;
  transition: background-color 0.35s ease, color 0.35s ease;
}

img,
svg {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font-family: inherit;
  cursor: pointer;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: var(--font-display);
  font-weight: 600;
  line-height: 1.15;
  margin: 0 0 0.6em;
  letter-spacing: 0.01em;
}

h1 {
  font-size: calc(2.6rem * var(--heading-scale));
}

h2 {
  font-size: calc(2rem * var(--heading-scale));
}

h3 {
  font-size: calc(1.35rem * var(--heading-scale));
}

p {
  margin: 0 0 1em;
}

:focus-visible {
  outline: 2px solid var(--color-gold);
  outline-offset: 3px;
}

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  z-index: 200;
  padding: 0.75rem 1.25rem;
  background: var(--color-button-bg);
  color: var(--color-button-text);
}

.skip-link:focus {
  left: 1rem;
}

.main-content {
  min-height: 60vh;
}

.container {
  width: min(var(--page-width), 100% - 3rem);
  margin-inline: auto;
}

.section {
  padding-block: var(--section-spacing);
}

.section--alt {
  background-color: var(--color-bg-alt);
}

.section__header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 2.5rem;
}

.section__kicker {
  font-family: var(--font-body);
  font-size: 0.78rem;
  font-weight: 500;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--zw-gold-text);
  margin: 0 0 0.6rem;
}

.section__title {
  margin: 0 0 0.4rem;
}

.section__title-accent {
  font-style: italic;
  color: var(--color-gold);
}

.section__intro {
  color: var(--color-ink-soft);
  font-size: 1.05rem;
}

.section__rule {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.7rem;
  margin: 1.1rem auto 0;
  color: var(--color-gold);
}

.section__rule::before,
.section__rule::after {
  content: "";
  height: 1px;
  width: 3rem;
  background: linear-gradient(90deg, transparent, var(--color-gold));
}

.section__rule::after {
  background: linear-gradient(90deg, var(--color-gold), transparent);
}

/* ---------- Buttons ---------- */

/* Boutons DS Zahowa : bordure fine dorée, fond transparent, uppercase, 0.22em */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.55rem;
  padding: 0.9em 2.6em;
  border-radius: 0;
  border: 1px solid var(--color-gold);
  background: transparent;
  font-family: var(--font-body);
  font-size: 0.92rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-ink);
  transition: background 0.45s ease, color 0.45s ease, border-color 0.45s ease;
}

.btn:hover {
  background: rgba(201, 163, 92, 0.12);
}

/* Variantes conservées pour compatibilité : style unifié bordure dorée */
.btn--primary,
.btn--gold,
.btn--outline {
  background: transparent;
  color: var(--color-ink);
  border-color: var(--color-gold);
}

.btn--primary:hover,
.btn--gold:hover,
.btn--outline:hover {
  background: rgba(201, 163, 92, 0.12);
  color: var(--color-ink);
}

/* Sur fond café : texte crème, bordure or (contraste conservé) */
.btn--light {
  background: transparent;
  color: #f5f0e8;
  border-color: var(--color-gold);
}

.btn--light:hover {
  background: rgba(201, 163, 92, 0.12);
}

.btn--full {
  width: 100%;
}

.btn--link {
  padding: 0;
  background: none;
  border: none;
  text-transform: none;
  letter-spacing: 0.08em;
  color: var(--zw-gold-text);
  font-weight: 500;
  text-decoration: underline;
  text-underline-offset: 4px;
}

/* ---------- Header ---------- */

.header {
  position: sticky;
  top: 0;
  z-index: 60;
  background: var(--color-bg);
  border-bottom: 1px solid var(--color-border);
  transition: background 0.3s ease, border-color 0.3s ease;
}

.header--transparent {
  background: transparent;
  border-bottom-color: transparent;
}

.header--transparent.is-scrolled {
  background: color-mix(in srgb, var(--color-bg) 92%, transparent);
  border-bottom-color: var(--color-border);
  backdrop-filter: blur(12px);
}

.header__inner {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  min-height: 72px;
}

.header__logo {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  white-space: nowrap;
}

.header__logo img,
.header__logo svg {
  width: var(--header-logo-width);
  height: auto;
}

.header__nav {
  margin-left: auto;
}

.header__menu {
  display: flex;
  gap: 1.6rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.header__menu-link {
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-ink);
  position: relative;
  padding-block: 0.4rem;
}

.header__menu-link::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: 0;
  width: 0;
  height: 1px;
  background: var(--color-gold);
  transition: width 0.25s ease;
}

.header__menu-link:hover::after,
.header__menu-link.is-active::after {
  width: 100%;
}

.header__actions {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin-left: auto;
}

.header__action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border: none;
  background: none;
  color: var(--color-ink);
  border-radius: 50%;
  position: relative;
  transition: background 0.2s ease, color 0.2s ease;
}

.header__action:hover {
  background: var(--color-bg-alt);
  color: var(--zw-gold-text);
}

.header__cart-count {
  position: absolute;
  top: 4px;
  right: 2px;
  min-width: 18px;
  height: 18px;
  padding: 0 4px;
  border-radius: 999px;
  background: var(--color-gold);
  color: #150c07;
  font-size: 0.68rem;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header__burger {
  display: none;
}

/* Mobile drawer */
.mobile-menu {
  position: fixed;
  inset: 0;
  z-index: 90;
  visibility: hidden;
}

.mobile-menu.is-open {
  visibility: visible;
}

.mobile-menu__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.mobile-menu.is-open .mobile-menu__backdrop {
  opacity: 1;
}

.mobile-menu__panel {
  position: absolute;
  top: 0;
  right: 0;
  height: 100%;
  width: min(360px, 88vw);
  background: var(--color-bg);
  padding: 1.5rem;
  transform: translateX(100%);
  transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  overflow-y: auto;
  box-shadow: -20px 0 40px rgba(0, 0, 0, 0.15);
}

.mobile-menu.is-open .mobile-menu__panel {
  transform: translateX(0);
}

.mobile-menu__close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  width: 40px;
  height: 40px;
  border: none;
  background: none;
  color: var(--color-ink);
  border-radius: 50%;
}

.mobile-menu__list {
  list-style: none;
  margin: 3.5rem 0 0;
  padding: 0;
  display: grid;
  gap: 0.4rem;
}

.mobile-menu__link {
  display: block;
  padding: 0.85rem 0.4rem;
  font-family: var(--font-display);
  font-size: 1.4rem;
  border-bottom: 1px solid var(--color-border);
}

/* ---------- Announcement ---------- */

.announcement {
  background: var(--color-gold);
  color: #150c07;
  text-align: center;
  padding: 0.55rem 1rem;
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.05em;
}

.announcement a {
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* ---------- Hero ---------- */

.hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 100svh;
  overflow: hidden;
  color: #f5f0e8;
  isolation: isolate;
}

.hero--short {
  min-height: 70svh;
}

.hero__media {
  position: absolute;
  inset: 0;
  z-index: -2;
}

.hero__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1.02);
}

.hero--parallax .hero__media img {
  will-change: transform;
}

.hero__overlay {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(100deg, rgba(21, 12, 7, 0.82) 0%, rgba(21, 12, 7, 0.55) 45%, rgba(21, 12, 7, 0.25) 100%);
}

.hero--center .hero__overlay {
  background: linear-gradient(0deg, rgba(21, 12, 7, 0.55) 0%, rgba(21, 12, 7, 0.35) 100%);
}

.hero__content {
  width: min(var(--page-width), 100% - 3rem);
  margin-inline: auto;
  padding-block: 7rem 5rem;
}

.hero--center .hero__content {
  text-align: center;
  display: grid;
  justify-items: center;
}

.hero__kicker {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.8rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--color-gold);
  margin-bottom: 1.2rem;
}

.hero__kicker::before {
  content: "";
  width: 2.2rem;
  height: 1px;
  background: var(--color-gold);
}

.hero--center .hero__kicker::before {
  display: none;
}

.hero__title {
  font-size: calc(clamp(2.5rem, 6.5vw, 4.6rem) * var(--heading-scale));
  color: #fffdf8;
  max-width: 14ch;
  margin-bottom: 1rem;
}

.hero--center .hero__title {
  max-width: 24ch;
}

.hero__title-accent {
  font-style: italic;
  color: var(--color-gold);
}

.hero__text {
  font-size: 1.15rem;
  color: rgba(245, 240, 232, 0.92);
  max-width: 46ch;
  margin-bottom: 2rem;
}

.hero__ctas {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}

/* Hero sur image sombre : texte crème pour les boutons à fond transparent */
.hero .btn {
  color: #f5f0e8;
}

.hero .btn:hover {
  color: #f5f0e8;
}

.hero__note {
  margin-top: 1.6rem;
  font-size: 0.85rem;
  color: rgba(245, 240, 232, 0.75);
}

.hero__note a {
  color: var(--color-gold);
  text-decoration: underline;
  text-underline-offset: 3px;
}

.hero__scroll {
  position: absolute;
  bottom: 1.8rem;
  left: 50%;
  transform: translateX(-50%);
  display: grid;
  justify-items: center;
  gap: 0.3rem;
  color: rgba(245, 240, 232, 0.8);
  font-size: 0.7rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  writing-mode: vertical-rl;
}

.hero__scroll-line {
  width: 1px;
  height: 3.2rem;
  background: linear-gradient(180deg, var(--color-gold), transparent);
  animation: hero-scroll 2s ease-in-out infinite;
}

@keyframes hero-scroll {
  0%,
  100% {
    transform: scaleY(0.4);
    transform-origin: top;
    opacity: 0.5;
  }
  50% {
    transform: scaleY(1);
    transform-origin: top;
    opacity: 1;
  }
}

/* ---------- Marquee ---------- */

.marquee {
  overflow: hidden;
  background: var(--color-bg-alt);
  border-block: 1px solid var(--color-border);
  padding-block: 1rem;
  white-space: nowrap;
}

.marquee--dark {
  background: var(--color-button-bg);
  color: var(--color-button-text);
}

.marquee__track {
  display: inline-flex;
  gap: 2.5rem;
  animation: marquee var(--marquee-speed) linear infinite;
  will-change: transform;
}

.marquee--reverse .marquee__track {
  animation-direction: reverse;
}

.marquee:hover .marquee__track {
  animation-play-state: paused;
}

.marquee__item {
  display: inline-flex;
  align-items: center;
  gap: 2.5rem;
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-style: italic;
  letter-spacing: 0.08em;
}

.marquee__item .icon {
  color: var(--color-gold);
}

@keyframes marquee {
  to {
    transform: translateX(-50%);
  }
}

/* ---------- Maison (story split) ---------- */

.maison__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: clamp(2rem, 6vw, 5rem);
}

.maison__media {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  aspect-ratio: 4 / 3;
}

.maison__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.maison__media:hover img {
  transform: scale(1.04);
}

.maison__content {
  max-width: 54ch;
}

.maison__kicker {
  font-size: 0.78rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--zw-gold-text);
  margin-bottom: 0.6rem;
}

.maison__title {
  margin-bottom: 1.2rem;
}

.maison__text {
  color: var(--color-ink-soft);
  font-size: 1.08rem;
}

/* ---------- Featured collection / product cards ---------- */

.collection-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1.8rem;
}

.card {
  position: relative;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
}

.card:hover {
  transform: translateY(-6px);
  box-shadow: 0 24px 48px -24px rgba(36, 22, 16, 0.35);
  border-color: var(--color-gold);
}

.card__media {
  position: relative;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--color-bg-alt);
}

.card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.7s ease;
}

.card:hover .card__media img {
  transform: scale(1.06);
}

.card__media--portrait {
  aspect-ratio: 4 / 5;
}

.card__body {
  padding: 1.1rem 1.2rem 1.3rem;
  display: grid;
  gap: 0.3rem;
}

.card__title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  margin: 0;
}

.card__subtitle {
  font-size: 0.85rem;
  letter-spacing: 0.06em;
  color: var(--color-ink-soft);
  text-transform: uppercase;
}

.card__price {
  font-weight: 500;
  color: var(--zw-gold-text);
  margin-top: 0.3rem;
}

/* ---------- Badges ---------- */

.badges {
  position: absolute;
  top: 0.8rem;
  left: 0.8rem;
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  z-index: 2;
}

.badges--static {
  position: static;
  margin-bottom: 0.8rem;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.3rem 0.7rem;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--badge-color, #f5f0e8);
  background: var(--badge-bg, #241610);
}

/* ---------- Recipes cards ---------- */

.recipes-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.6rem;
}

.recipe-card {
  display: flex;
  flex-direction: column;
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.recipe-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 24px 48px -24px rgba(36, 22, 16, 0.35);
}

.recipe-card__media {
  aspect-ratio: 3 / 2;
  overflow: hidden;
}

.recipe-card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.7s ease;
}

.recipe-card:hover .recipe-card__media img {
  transform: scale(1.06);
}

.recipe-card__body {
  padding: 1.3rem;
  display: grid;
  gap: 0.5rem;
  flex: 1;
}

.recipe-card__tagline {
  font-size: 0.78rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--zw-gold-text);
}

.recipe-card__title {
  font-family: var(--font-display);
  font-size: 1.4rem;
  margin: 0;
}

.recipe-card__desc {
  color: var(--color-ink-soft);
  font-size: 0.95rem;
  margin: 0;
}

.recipe-card__usage {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.88rem;
  color: var(--color-ink);
  border-top: 1px dashed var(--color-border);
  padding-top: 0.7rem;
}

.recipe-card__usage .icon {
  color: var(--color-gold);
  flex-shrink: 0;
}

.recipe-card__composition {
  font-size: 0.85rem;
  color: var(--color-ink-soft);
  margin: 0;
}

.recipe-card__composition strong {
  display: block;
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--zw-gold-text);
  margin-bottom: 0.2rem;
}

/* ---------- Rituel ---------- */

.rituel__steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
  counter-reset: rituel;
}

.rituel__step {
  position: relative;
  text-align: center;
  padding: 2rem 1.4rem;
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  background: var(--color-bg-card);
  transition: transform 0.3s ease, border-color 0.3s ease;
}

.rituel__step:hover {
  transform: translateY(-6px);
  border-color: var(--color-gold);
}

.rituel__number {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 2.6rem;
  color: var(--color-gold);
  line-height: 1;
  margin-bottom: 0.4rem;
}

.rituel__icon {
  color: var(--zw-gold-text);
  margin: 0 auto 0.8rem;
}

.rituel__title {
  font-family: var(--font-display);
  font-size: 1.3rem;
  margin-bottom: 0.4rem;
}

.rituel__text {
  color: var(--color-ink-soft);
  font-size: 0.95rem;
  margin: 0;
}

/* ---------- Coffret ---------- */

.coffret {
  position: relative;
  overflow: hidden;
  border-radius: calc(var(--radius) * 1.5);
  background: linear-gradient(135deg, var(--color-bg-alt), var(--color-bg-card));
  border: 1px solid var(--color-border);
}

.coffret__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: clamp(2rem, 5vw, 4rem);
}

.coffret--reverse .coffret__grid {
  direction: rtl;
}

.coffret--reverse .coffret__grid > * {
  direction: ltr;
}

.coffret__media {
  position: relative;
  border-radius: var(--radius);
  overflow: hidden;
  aspect-ratio: 4 / 3;
}

.coffret__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}

.coffret:hover .coffret__media img {
  transform: scale(1.04);
}

.coffret__content {
  max-width: 50ch;
}