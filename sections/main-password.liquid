<section class="section" style="min-height:100svh;display:flex;align-items:center;">
  <div class="container" style="max-width:520px;">
    <div class="auth-card">
      {% if section.settings.image != blank %}
        <div style="max-width:160px;margin:0 auto 1.5rem;">
          {{ section.settings.image | image_url: width: 400 | image_tag: alt: shop.name, loading: 'eager' }}
        </div>
      {% endif %}
      <h1>{{ 'sections.main_password.title' | t }}</h1>
      <p style="color:var(--color-ink-soft);text-align:center;">{{ 'sections.main_password.text' | t }}</p>

      {% form 'storefront_password' %}
        {% if form.errors %}
          <div class="form-errors">{{ form.errors | default_errors }}</div>
        {% endif %}
        <div style="display:flex;gap:0.6rem;margin-top:1.2rem;">
          <input
            type="password"
            name="password"
            class="cercle__input"
            style="color:var(--color-ink);background:var(--color-bg-card);border-color:var(--color-border);"
            placeholder="{{ 'sections.main_password.password' | t }}"
            required
          >
          <button type="submit" class="btn btn--primary">{{ 'sections.main_password.submit' | t }}</button>
        </div>
      {% endform %}

      <div class="auth-links">
        <a href="/admin">{{ 'sections.main_password.admin' | t }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.maison.image_label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main_password.name"
    }
  ]
}
{% endschema %}
