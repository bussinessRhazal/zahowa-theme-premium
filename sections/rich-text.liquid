<section class="zw-scheme-{{ section.settings.color_scheme }} section{% if section.settings.alt_bg %} section--alt{% endif %}" {% if section.settings.id != blank %}id="{{ section.settings.id }}"{% endif %}>
  <div class="container" style="max-width: 760px;">
    <div class="section__header" data-reveal>
      {% if section.settings.kicker != blank %}
        <p class="section__kicker">{{ section.settings.kicker }}</p>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="section__title">
          {{ section.settings.title | replace_first: '*', '<em class="section__title-accent">' | replace_first: '*', '</em>' }}
        </h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="section__intro">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link | default: routes.root_url }}" class="btn btn--outline">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleur de fond",
      "options": [
        {
          "value": "creme",
          "label": "Crème (clair)"
        },
        {
          "value": "cafe",
          "label": "Café foncé (sombre)"
        }
      ],
      "default": "creme"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.maison.kicker_label"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.rich_text.title_label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.rich_text.text_label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.rich_text.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.maison.button_link"
    },
    {
      "type": "checkbox",
      "id": "alt_bg",
      "label": "t:sections.maison.alt_bg_label",
      "default": false
    },
    {
      "type": "text",
      "id": "id",
      "label": "t:sections.hero.anchor_label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich_text.name"
    }
  ]
}
{% endschema %}
