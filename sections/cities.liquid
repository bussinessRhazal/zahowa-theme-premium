{% comment %}
  ZAHOWA — Section 4 Villes
  Usage: Grille de cartes ville avec blocs repetables (2 a 4 villes)
  Parametres: titre, eyebrow, blocs ville avec image/nom/epice/description
  v2 : bouton CTA en bas de section (Voir nos recettes)
{% endcomment %}

<section
  id="section-{{ section.id }}"
  class="zh-cities-section zw-scheme-{{ section.settings.color_scheme }}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.title != blank -%}
      <div class="zh-cities-header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="zh-cities-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <div class="zh-cities-title">{{ section.settings.title }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="zh-cities-grid zh-cities-count-{{ section.blocks.size }}">
        {%- for block in section.blocks -%}
          <div class="zh-city-card" {{ block.shopify_attributes }}>
            <div class="zh-city-image">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 800 }}" srcset="{{ block.settings.image | image_url: width: 480 }} 480w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w" sizes="(max-width: 768px) 100vw, 25vw" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="800" height="1067">
              {%- else -%}
                <div class="zh-city-ph" style="background: {{ block.settings.fallback_color | default: '#2e1c13' }};"></div>
              {%- endif -%}
              <div class="zh-city-shade"></div>
            </div>
            <div class="zh-city-info">
              <span class="zh-city-num">0{{ forloop.index }}</span>
              {%- if block.settings.name != blank -%}<h3 class="zh-city-name">{{ block.settings.name }}</h3>{%- endif -%}
              {%- if block.settings.spice != blank -%}<span class="zh-city-spice">{{ block.settings.spice }}</span>{%- endif -%}
              {%- if block.settings.description != blank -%}<p class="zh-city-desc">{{ block.settings.description }}</p>{%- endif -%}
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="zw-city-btn">{{ block.settings.link_label | default: 'Lire la recette' }} →</a>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="zh-cities-empty">Ajoutez des villes dans les blocs ci-dessus.</div>
    {%- endif -%}

    {%- if section.settings.show_cta -%}
      <div class="zh-cities-cta">
        <a href="{{ section.settings.cta_link | default: '/collections/nos-recettes' }}" class="zw-cities-btn">
          {{ section.settings.cta_label | default: 'Voir nos recettes' | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
#section-{{ section.id }}.zh-cities-section { width: 100%; margin: 0; }
#section-{{ section.id }}.zw-scheme-cafe { background: #241610; }
#section-{{ section.id }}.zw-scheme-creme { background: #f5f0e8; }
#section-{{ section.id }} .zh-cities-header { text-align: center; margin-bottom: 60px; }
#section-{{ section.id }} .zh-cities-eyebrow { font-family: var(--zw-font-body, 'Jost', sans-serif); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.3em; color: var(--zw-gold-400, #c9a35c); margin-bottom: 16px; display: block; }
#section-{{ section.id }} .zh-cities-title { font-family: var(--zw-font-display, 'Cormorant Garamond', Georgia, serif); font-size: clamp(28px, 4vw, 52px); font-weight: 400; color: #f5f0e8; line-height: 1.1; margin: 0; }
#section-{{ section.id }}.zw-scheme-creme .zh-cities-title { color: #241610; }
#section-{{ section.id }} .zh-cities-title em, #section-{{ section.id }} .zh-cities-title i { font-style: italic; color: var(--zw-gold-400, #c9a35c); }
#section-{{ section.id }} .zh-cities-grid { display: grid; gap: 20px; max-width: 1100px; margin: 0 auto; }
#section-{{ section.id }} .zh-cities-count-2 { grid-template-columns: repeat(2, 1fr); }
#section-{{ section.id }} .zh-cities-count-3 { grid-template-columns: repeat(3, 1fr); }
#section-{{ section.id }} .zh-cities-count-4 { grid-template-columns: repeat(4, 1fr); }
#section-{{ section.id }} .zh-city-card { position: relative; aspect-ratio: 3 / 4; overflow: hidden; cursor: pointer; border-radius: 2px; }
#section-{{ section.id }} .zh-city-image { position: absolute; inset: 0; transition: transform 0.8s cubic-bezier(0.25, 0.1, 0.25, 1); }
#section-{{ section.id }} .zh-city-card:hover .zh-city-image { transform: scale(1.08); }
#section-{{ section.id }} .zh-city-image img, #section-{{ section.id }} .zh-city-ph { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
#section-{{ section.id }} .zh-city-shade { position: absolute; inset: 0; background: linear-gradient(to top, rgba(36,22,16,0.88) 0%, rgba(36,22,16,0.15) 55%, transparent 100%); z-index: 1; transition: background 0.5s; }
#section-{{ section.id }} .zh-city-card:hover .zh-city-shade { background: linear-gradient(to top, rgba(36,22,16,0.95) 0%, rgba(36,22,16,0.35) 60%, rgba(36,22,16,0.05) 100%); }
#section-{{ section.id }} .zh-city-info { position: absolute; bottom: 0; left: 0; right: 0; padding: 24px; z-index: 2; }
#section-{{ section.id }} .zh-city-num { font-family: var(--zw-font-display, 'Cormorant Garamond', Georgia, serif); font-size: 44px; font-weight: 400; color: rgba(201,163,92,0.35); line-height: 1; margin-bottom: 8px; }
#section-{{ section.id }} .zh-city-name { font-family: var(--zw-font-display, 'Cormorant Garamond', Georgia, serif); font-size: 24px; font-weight: 500; color: #f5f0e8; margin: 0 0 4px; }
#section-{{ section.id }} .zh-city-spice { font-family: var(--zw-font-body, 'Jost', sans-serif); font-size: 10px; text-transform: uppercase; letter-spacing: 0.2em; color: var(--zw-gold-400, #c9a35c); margin-bottom: 8px; display: block; }
#section-{{ section.id }} .zh-city-desc { font-family: var(--zw-font-body, 'Jost', sans-serif); font-size: 13px; color: rgba(245,240,232,0.6); line-height: 1.6; margin: 0; max-height: 0; overflow: hidden; opacity: 0; transition: all 0.5s cubic-bezier(0.25, 0.1, 0.25, 1); }
#section-{{ section.id }} .zh-city-card:hover .zh-city-desc { max-height: 120px; opacity: 1; margin-top: 8px; }
#section-{{ section.id }} .zw-city-btn { display: inline-flex; align-items: center; gap: 0.6em; padding: 0.7em 2em; border: 1px solid var(--color-gold, #c9a35c); background: transparent; color: #f5f0e8; text-transform: uppercase; letter-spacing: 0.22em; font-size: 0.78rem; font-family: var(--zw-font-body, 'Jost', sans-serif); border-radius: 0; text-decoration: none; margin-top: 14px; transition: background 0.45s ease; }
#section-{{ section.id }} .zw-city-btn:hover { background: rgba(201,163,92,0.12); }
#section-{{ section.id }}.zw-scheme-creme .zw-city-btn { color: #241610; }
#section-{{ section.id }} .zh-cities-cta { text-align: center; margin-top: 56px; }
#section-{{ section.id }} .zw-cities-btn { display: inline-flex; align-items: center; padding: 1rem 2.6em; border: 1px solid var(--color-gold, #c9a35c); background: transparent; color: #f5f0e8; text-transform: uppercase; letter-spacing: 0.22em; font-size: 0.78rem; font-family: var(--zw-font-body, 'Jost', sans-serif); border-radius: 0; text-decoration: none; transition: background 0.45s ease, color 0.45s ease; }
#section-{{ section.id }} .zw-cities-btn:hover { background: var(--color-gold, #c9a35c); color: #241610; }
#section-{{ section.id }}.zw-scheme-creme .zw-cities-btn { color: #241610; }
#section-{{ section.id }}.zw-scheme-creme .zw-cities-btn:hover { background: rgba(201,163,92,0.25); color: #241610; }
#section-{{ section.id }} .zh-cities-empty { text-align: center; font-family: var(--zw-font-body, 'Jost', sans-serif); font-size: 14px; color: rgba(36,22,16,0.4); padding: 60px; }
@media (max-width: 1024px) { #section-{{ section.id }} .zh-cities-count-4, #section-{{ section.id }} .zh-cities-count-3 { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 768px) { #section-{{ section.id }} .zh-cities-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 12px; } #section-{{ section.id }} .zh-city-card { aspect-ratio: 1 / 1; } #section-{{ section.id }} .zh-cities-header { margin-bottom: 40px; } #section-{{ section.id }} .zh-city-desc { max-height: none; opacity: 1; margin-top: 8px; } }
@media (max-width: 480px) { #section-{{ section.id }} .zh-cities-grid { grid-template-columns: 1fr !important; } #section-{{ section.id }} .zh-city-card { aspect-ratio: 16 / 9; } }
</style>

{% schema %}
{
  "name": "Zahowa — 4 Villes",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleur de fond",
      "options": [
        { "value": "creme", "label": "Crème (clair)" },
        { "value": "cafe", "label": "Café foncé (sombre)" }
      ],
      "default": "cafe"
    },
    {
      "type": "header",
      "content": "En-tete"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label (eyebrow)",
      "default": "Les origines"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Titre",
      "default": "<p>Quatre villes,<br><em>quatre caracteres</em></p>"
    },
    {
      "type": "header",
      "content": "Bouton en bas de section"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Afficher le bouton",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Libellé du bouton",
      "default": "Voir nos recettes"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien du bouton (par défaut : page des recettes)"
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 200,
      "step": 10,
      "default": 100,
      "unit": "px",
      "label": "Espacement haut"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 200,
      "step": 10,
      "default": 100,
      "unit": "px",
      "label": "Espacement bas"
    }
  ],
  "blocks": [
    {
      "type": "city",
      "name": "Ville",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image de la ville"
        },
        {
          "type": "color",
          "id": "fallback_color",
          "label": "Couleur de remplacement (si pas d'image)",
          "default": "#2e1c13",
          "info": "Couleur de fond si aucune image n'est selectionnee"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nom de la ville",
          "default": "Fes"
        },
        {
          "type": "text",
          "id": "spice",
          "label": "Epice / Caracteristique",
          "default": "Cannelle"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "La contemplation. Dans les ruelles sans fin, on trouve des tresors que personne d'autre ne voit. Mysterieux, intemporel."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien recette"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Libellé du bouton",
          "default": "Lire la recette"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zahowa — 4 Villes",
      "blocks": {
        "city_1": {
          "type": "city"
        },
        "city_2": {
          "type": "city"
        },
        "city_3": {
          "type": "city"
        },
        "city_4": {
          "type": "city"
        }
      },
      "block_order": [
        "city_1",
        "city_2",
        "city_3",
        "city_4"
      ]
    }
  ]
}
{% endschema %}
