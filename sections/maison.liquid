<section class="zw-scheme-{{ section.settings.color_scheme }} section maison{% if section.settings.alt_bg %} section--alt{% endif %}" {% if section.settings.id != blank %}id="{{ section.settings.id }}"{% endif %}>
  <div class="container maison__grid">
    <div class="maison__media" data-reveal>
      {% if section.settings.image != blank %}
        {% assign maison_alt = section.settings.image.alt | escape | default: section.settings.title %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: alt: maison_alt, loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '480, 800, 1200' }}
      {% else %}
        <div class="maison__placeholder"></div>
      {% endif %}
    </div>
    <div class="maison__content" data-reveal>
      {% if section.settings.kicker != blank %}
        <p class="maison__kicker">{{ section.settings.kicker }}</p>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="maison__title">
          {{ section.settings.title | replace_first: '*', '<em class="section__title-accent">' | replace_first: '*', '</em>' }}
        </h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="maison__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link | default: routes.root_url }}" class="btn btn--outline">
          {{ section.settings.button_label }}
          {% render 'icon', name: 'arrow' %}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.maison.name",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleur de fond",
      "options": [
        {
          "value": "creme",
          "label": "Crème (clair)"
        },
        {
          "value": "cafe",
          "label": "Café foncé (sombre)"
        }
      ],
      "default": "creme"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.maison.image_label"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.maison.kicker_label",
      "default": "Notre histoire"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.maison.title_label",
      "info": "t:sections.hero.title_info",
      "default": "La *Maison*"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.maison.text_label",
      "default": "<p>Née à Fès, Zahowa célèbre le mariage du café arabica et des épices marocaines. Chaque recette raconte une ville, chaque tasse un rituel.</p>"
    },
    {
      "type": "header",
      "content": "t:sections.maison.button_header"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.maison.button_label",
      "default": "Découvrir l'histoire"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.maison.button_link"
    },
    {
      "type": "checkbox",
      "id": "alt_bg",
      "label": "t:sections.maison.alt_bg_label",
      "default": false
    },
    {
      "type": "text",
      "id": "id",
      "label": "t:sections.hero.anchor_label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.maison.name"
    }
  ]
}
{% endschema %}
