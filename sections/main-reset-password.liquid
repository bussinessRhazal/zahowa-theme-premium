<section class="auth-wrap">
  <div class="container">
    <div class="auth-card">
      <h1>{{ 'sections.main_login.recover_title' | t }}</h1>
      {% form 'reset_customer_password' %}
        {% if form.errors %}
          <div class="form-errors">{{ form.errors | default_errors }}</div>
        {% endif %}
        <div class="form-field">
          <label for="ResetPassword">{{ 'sections.main_login.password' | t }}</label>
          <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
        </div>
        <div class="form-field">
          <label for="ResetPasswordConfirmation">{{ 'sections.main_login.password' | t }} (confirmation)</label>
          <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirmation" autocomplete="new-password" required>
        </div>
        <button type="submit" class="btn btn--primary btn--full">{{ 'sections.main_login.recover_submit' | t }}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_reset.name",
  "settings": [],
  "presets": [
    {
      "name": "t:sections.main_reset.name"
    }
  ]
}
{% endschema %}
