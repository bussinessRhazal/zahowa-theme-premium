{%- comment -%}
  Zahowa — Newsletter (inscription email autonome, panneau vert nuit)
{%- endcomment -%}

<section class="zw-scheme-{{ section.settings.color_scheme }} section" {% if section.settings.id != blank %}id="{{ section.settings.id }}"{% endif %}>
  <div class="container">
    <div class="zh-newsletter" data-reveal>
      {%- if section.settings.kicker != blank -%}
        <p class="zh-newsletter__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="zh-newsletter__title">
          {{ section.settings.title | replace_first: '*', '<em>' | replace_first: '*', '</em>' }}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="zh-newsletter__text">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'zh-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="zh-newsletter__row">
          <input
            type="email"
            name="contact[email]"
            class="zh-newsletter__input"
            placeholder="{{ section.settings.placeholder | default: 'Votre adresse email' | escape }}"
            aria-label="{{ section.settings.placeholder | default: 'Votre adresse email' | escape }}"
            required
          >
          <button type="submit" class="zh-newsletter__btn">{{ section.settings.button_label | default: "S'inscrire" | escape }}</button>
        </div>
        {%- if form.posted_successfully? -%}
          <p class="zh-newsletter__success">{{ section.settings.success_message | default: 'Merci ! Votre inscription est confirmée.' }}</p>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="zh-newsletter__error">{{ form.errors | default_errors }}</div>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.note != blank -%}
        <p class="zh-newsletter__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{%- style -%}
  #shopify-section-{{ section.id }} .zh-newsletter {
    text-align: center;
    padding: clamp(3rem, 6vw, 4.5rem) 1.5rem;
    background: var(--zw-coffee-950, #241610);
    color: var(--zw-cream-text, #efe6d8);
    border: 1px solid color-mix(in srgb, var(--zw-gold-400, #c9a35c) 20%, transparent);
  }

  #shopify-section-{{ section.id }} .zh-newsletter__kicker {
    font-family: var(--zw-font-body, 'Jost', sans-serif);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--zw-gold-400, #c9a35c);
    margin: 0 0 0.75rem;
  }

  #shopify-section-{{ section.id }} .zh-newsletter__title {
    font-family: var(--zw-font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 400;
    line-height: 1.15;
    margin: 0 0 0.75rem;
  }
  #shopify-section-{{ section.id }} .zh-newsletter__title em {
    font-style: italic;
    color: var(--zw-gold-400, #c9a35c);
  }

  #shopify-section-{{ section.id }} .zh-newsletter__text {
    font-family: var(--zw-font-body, 'Jost', sans-serif);
    font-size: 0.95rem;
    line-height: 1.7;
    opacity: 0.8;
    max-width: 520px;
    margin: 0 auto 2rem;
  }

  #shopify-section-{{ section.id }} .zh-newsletter__form {
    max-width: 460px;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .zh-newsletter__row {
    display: flex;
    gap: 0.5rem;
  }

  #shopify-section-{{ section.id }} .zh-newsletter__input {
    flex: 1;
    min-width: 0;
    padding: 0.95rem 1.1rem;
    background: rgba(245, 240, 232, 0.06);
    border: 1px solid color-mix(in srgb, var(--zw-gold-400, #c9a35c) 25%, transparent);
    color: var(--zw-cream-text, #efe6d8);
    font-family: var(--zw-font-body, 'Jost', sans-serif);
    font-size: 0.9rem;
    transition: border-color var(--zw-transition);
  }
  #shopify-section-{{ section.id }} .zh-newsletter__input::placeholder {
    color: rgba(239, 230, 216, 0.45);
  }
  #shopify-section-{{ section.id }} .zh-newsletter__input:focus {
    outline: none;
    border-color: var(--zw-gold-400, #c9a35c);
  }

  #shopify-section-{{ section.id }} .zh-newsletter__btn {
    padding: 0.95rem 1.5rem;
    background: var(--zw-gold-400, #c9a35c);
    border: 1px solid var(--zw-gold-400, #c9a35c);
    color: var(--zw-coffee-950, #241610);
    font-family: var(--zw-font-body, 'Jost', sans-serif);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all var(--zw-transition);
  }
  #shopify-section-{{ section.id }} .zh-newsletter__btn:hover {
    background: transparent;
    color: var(--zw-gold-400, #c9a35c);
  }

  #shopify-section-{{ section.id }} .zh-newsletter__success {
    margin-top: 1rem;
    font-family: var(--zw-font-body, 'Jost', sans-serif);
    color: var(--color-success);
  }

  #shopify-section-{{ section.id }} .zh-newsletter__error {
    margin-top: 1rem;
    font-family: var(--zw-font-body, 'Jost', sans-serif);
    color: var(--color-error);
  }

  #shopify-section-{{ section.id }} .zh-newsletter__note {
    margin-top: 1.25rem;
    font-family: var(--zw-font-body, 'Jost', sans-serif);
    font-size: 0.75rem;
    opacity: 0.55;
  }

  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .zh-newsletter__row {
      flex-direction: column;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Zahowa — Newsletter",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleur de fond",
      "options": [
        {
          "value": "creme",
          "label": "Crème (clair)"
        },
        {
          "value": "cafe",
          "label": "Café foncé (sombre)"
        }
      ],
      "default": "cafe"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Label (eyebrow)",
      "default": "Le Cercle Zahowa"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre (utilisez *mot* pour l'accent)",
      "default": "Rejoignez *l'aventure*"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Histoires, recettes et accès en avant-première. Un email par mois, jamais plus."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Placeholder du champ email",
      "default": "Votre adresse email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Libellé du bouton",
      "default": "S'inscrire"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Message de confirmation",
      "default": "Merci ! Votre inscription est confirmée."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note en bas (confidentialité)",
      "default": "Désinscription en un clic, à tout moment."
    },
    {
      "type": "text",
      "id": "id",
      "label": "Ancre (id HTML)"
    }
  ],
  "presets": [
    {
      "name": "Zahowa — Newsletter",
      "category": "Zahowa"
    }
  ]
}
{% endschema %}
