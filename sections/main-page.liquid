<section class="section">
  <div class="container">
    <div class="page-header">
      <h1 class="page-header__title">{{ page.title }}</h1>
    </div>
    <div class="article" style="padding-block:0;">
      <div class="article__content">
        {{ page.content }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_page.name",
  "settings": [],
  "presets": [
    {
      "name": "t:sections.main_page.name"
    }
  ]
}
{% endschema %}
