<section class="zw-scheme-{{ section.settings.color_scheme }} section">
  <div class="container">
    <div class="page-header">
      <h1 class="page-header__title">{{ page.title }}</h1>
    </div>
    <div class="article" style="padding-block:0;">
      <div class="article__content">
        {{ page.content }}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_page.name",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleur de fond",
      "options": [
        {
          "value": "creme",
          "label": "Crème (clair)"
        },
        {
          "value": "cafe",
          "label": "Café foncé (sombre)"
        }
      ],
      "default": "creme"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main_page.name"
    }
  ]
}
{% endschema %}
