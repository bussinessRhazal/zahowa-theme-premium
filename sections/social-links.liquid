<section class="zw-scheme-{{ section.settings.color_scheme }} section social-bar social-bar--{{ section.settings.alignment }}" {% if section.settings.id != blank %}id="{{ section.settings.id }}"{% endif %}>
  <div class="container">
    {% if section.settings.kicker != blank or section.settings.title != blank %}
      <div class="section__header" data-reveal>
        {% if section.settings.kicker != blank %}
          <p class="section__kicker">{{ section.settings.kicker }}</p>
        {% endif %}
        {% if section.settings.title != blank %}
          <h2 class="section__title">
            {{ section.settings.title | replace_first: '*', '<em class="section__title-accent">' | replace_first: '*', '</em>' }}
          </h2>
        {% endif %}
        <span class="section__rule">{% render 'icon', name: 'diamond' %}</span>
      </div>
    {% endif %}

    <div class="social-bar__wrap social-bar__wrap--{{ section.settings.size }}" data-reveal>
      {% render 'social-links', class: 'social-bar__list' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Réseaux sociaux",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleur de fond",
      "options": [
        { "value": "creme", "label": "Crème (clair)" },
        { "value": "cafe", "label": "Café foncé (sombre)" }
      ],
      "default": "creme"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Sur-titre",
      "default": "Suivez-nous"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Le rituel *continue* ailleurs"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignement",
      "options": [
        { "value": "left", "label": "Gauche" },
        { "value": "center", "label": "Centré" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Taille des icônes",
      "options": [
        { "value": "md", "label": "Moyenne" },
        { "value": "lg", "label": "Grande" }
      ],
      "default": "md"
    },
    {
      "type": "text",
      "id": "id",
      "label": "Ancre (optionnel)"
    }
  ],
  "presets": [
    {
      "name": "Réseaux sociaux"
    }
  ]
}
{% endschema %}
