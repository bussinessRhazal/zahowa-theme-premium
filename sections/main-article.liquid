<section class="zw-scheme-{{ section.settings.color_scheme }} section">
  <div class="container">
    <article class="article">
      <div class="article__header">
        <p class="article__date">{{ article.published_at | date: '%d %B %Y' }}</p>
        <h1 class="page-header__title">{{ article.title }}</h1>
        {% if article.author != blank %}
          <p>{{ 'sections.main_article.author' | t }} {{ article.author }}</p>
        {% endif %}
      </div>

      {% if article.image != blank %}
        {% assign article_alt = article.image.alt | escape | default: article.title %}
        <div class="article__media">
          {{ article.image | image_url: width: 1600 | image_tag: alt: article_alt, loading: 'lazy', sizes: '100vw', widths: '800, 1200, 1600' }}
        </div>
      {% endif %}

      <div class="article__content">
        {{ article.content }}
      </div>

      {% if article.tags.size > 0 %}
        <p class="article-card__date" style="margin-top:2rem;">
          {{ 'sections.main_article.tags' | t }} :
          {% for tag in article.tags %}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" style="text-decoration:underline;">{{ tag }}</a>{% unless forloop.last %}, {% endunless %}
          {% endfor %}
        </p>
      {% endif %}

      {% if blog.comments_enabled? %}
        <div style="margin-top:3rem;border-top:1px solid var(--color-border);padding-top:2rem;">
          <h2>{{ 'sections.main_article.comments' | t }} ({{ article.comments_count }})</h2>

          {% if article.comments_count > 0 %}
            <div style="display:grid;gap:1.2rem;margin-bottom:2rem;">
              {% for comment in article.comments %}
                <div style="background:var(--color-bg-card);border:1px solid var(--color-border);border-radius:var(--radius);padding:1.2rem;">
                  <strong>{{ comment.author }}</strong>
                  <p style="margin-top:0.4rem;">{{ comment.content }}</p>
                  <p class="article-card__date">{{ comment.created_at | date: '%d %B %Y' }}</p>
                </div>
              {% endfor %}
            </div>
          {% endif %}

          {% if article.comments_allowed? %}
            {% form 'new_comment', article %}
              <div class="form-field">
                <label for="CommentAuthor">{{ 'sections.main_article.comment_name' | t }}</label>
                <input type="text" name="comment[author]" id="CommentAuthor" required>
              </div>
              <div class="form-field">
                <label for="CommentEmail">{{ 'sections.main_article.comment_email' | t }}</label>
                <input type="email" name="comment[email]" id="CommentEmail" required>
              </div>
              <div class="form-field">
                <label for="CommentBody">{{ 'sections.main_article.comment_body' | t }}</label>
                <textarea name="comment[body]" id="CommentBody" required></textarea>
              </div>
              {% if form.errors %}
                <div class="form-errors">{{ form.errors | default_errors }}</div>
              {% endif %}
              {% if form.posted_successfully? %}
                <p class="form-success">{{ 'sections.main_article.moderated' | t }}</p>
              {% endif %}
              <button type="submit" class="btn btn--primary">{{ 'sections.main_article.comment_submit' | t }}</button>
            {% endform %}
          {% else %}
            <p>{{ 'sections.main_article.comments_closed' | t }}</p>
          {% endif %}
        </div>
      {% endif %}
    </article>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_article.name",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleur de fond",
      "options": [
        {
          "value": "creme",
          "label": "Crème (clair)"
        },
        {
          "value": "cafe",
          "label": "Café foncé (sombre)"
        }
      ],
      "default": "creme"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main_article.name"
    }
  ]
}
{% endschema %}
