{%- comment -%} Section : Comment choisir ta recette — cartes de caractère + bandeau coffret {%- endcomment -%}
<section class="section zw-scheme-{{ section.settings.color_scheme }} zwc" id="section-{{ section.id }}">
  <div class="container">
    <div class="section__header" data-reveal>
      {% if section.settings.kicker != blank %}<p class="section__kicker">{{ section.settings.kicker }}</p>{% endif %}
      {% if section.settings.title != blank %}
        <h2 class="section__title">{{ section.settings.title | replace_first: '*', '<em class="section__title-accent">' | replace_first: '*', '</em>' }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}<p class="section__intro">{{ section.settings.text }}</p>{% endif %}
      <span class="section__rule">{% render 'icon', name: 'diamond' %}</span>
    </div>

    <div class="zwc__grid">
      {% for block in section.blocks %}
        <article class="zwc__card" data-reveal {{ block.shopify_attributes }}>
          <div class="zwc__media">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: alt: block.settings.name, loading: 'lazy', sizes: '(min-width: 990px) 25vw, 100vw', widths: '400, 600, 800' }}
            {% elsif block.settings.asset_fallback != blank %}
              <img src="{{ block.settings.asset_fallback | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy" width="1024" height="1536">
            {% endif %}
            {% if block.settings.badge != blank %}
              <span class="zwc__badge">{{ block.settings.badge }}</span>
            {% endif %}
            <a class="zwc__veil" href="{{ block.settings.link | default: '#' }}" aria-label="Découvrir {{ block.settings.name | escape }}">
              <span class="zwc__veil-btn">{{ section.settings.card_cta | default: 'Découvrir' }}</span>
            </a>
          </div>
          <div class="zwc__body">
            <h3 class="zwc__name">
              {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.name }}</a>{% else %}{{ block.settings.name }}{% endif %}
            </h3>
            {% if block.settings.accroche != blank %}
              <p class="zwc__accroche">{{ block.settings.accroche }}</p>
            {% endif %}
            {% if block.settings.epices != blank %}
              <p class="zwc__epices">{{ block.settings.epices }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.show_coffret %}
      <div class="zwc__coffret" data-reveal>
        <div class="zwc__coffret-media">
          {% if section.settings.coffret_image != blank %}
            {{ section.settings.coffret_image | image_url: width: 1000 | image_tag: alt: section.settings.coffret_title, loading: 'lazy' }}
          {% elsif section.settings.coffret_asset != blank %}
            <img src="{{ section.settings.coffret_asset | asset_url }}" alt="{{ section.settings.coffret_title | escape }}" loading="lazy" width="2048" height="1152">
          {% endif %}
        </div>
        <div class="zwc__coffret-body">
          <p class="zwc__coffret-kicker">{{ section.settings.coffret_kicker }}</p>
          <h3 class="zwc__coffret-title">{{ section.settings.coffret_title }}</h3>
          <p class="zwc__coffret-text">{{ section.settings.coffret_text }}</p>
          {% if section.settings.coffret_cta_label != blank %}
            <a href="{{ section.settings.coffret_cta_link | default: '#' }}" class="zwc__coffret-btn">{{ section.settings.coffret_cta_label }}</a>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

<style>
  .zwc__grid{
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem; max-width: 78rem; margin: 0 auto;
  }
  .zwc__card{ display: flex; flex-direction: column; }
  .zwc__media{
    position: relative; overflow: hidden;
    border: 1px solid rgba(201,163,92,.35);
  }
  .zwc__media img{ display: block; width: 100%; height: auto; }
  .zwc__badge{
    position: absolute; top: .9rem; left: .9rem;
    padding: .35rem .7rem; background: rgba(36,22,16,.85);
    color: #c9a35c; font-size: .62rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: .2em;
  }
  .zwc__veil{
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    background: rgba(245,240,232,.82); opacity: 0; transition: opacity .35s ease;
  }
  .zwc__card:hover .zwc__veil, .zwc__card:focus-within .zwc__veil{ opacity: 1; }
  .zwc__veil-btn{
    padding: .8rem 1.6rem; border: 1px solid #c9a35c; background: transparent;
    color: #241610; font-size: .68rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: .22em;
  }
  .zwc__body{ padding: 1.4rem .25rem 0; text-align: center; }
  .zwc__name{
    font-family: var(--font-display); font-style: italic; font-weight: 500;
    font-size: 1.35rem; line-height: 1.3;
  }
  .zwc__name a{ color: inherit; text-decoration: none; }
  .zwc__name a:hover{ color: var(--color-gold-dark, #a5823f); }
  .zwc__accroche{
    margin-top: .6rem; font-size: .92rem; line-height: 1.65; opacity: .82;
  }
  .zwc__epices{
    margin-top: .9rem; font-size: .68rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: .18em;
    color: var(--color-gold-dark, #a5823f);
  }
  .zwc__coffret{
    display: grid; grid-template-columns: 1.15fr 1fr; align-items: center;
    gap: 3rem; max-width: 68rem; margin: 4.5rem auto 0;
    padding: 2.5rem; border: 1px solid rgba(201,163,92,.35);
  }
  .zwc__coffret-media img{ display: block; width: 100%; height: auto; }
  .zwc__coffret-kicker{
    font-size: .68rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: .22em; color: var(--color-gold-dark, #a5823f); margin-bottom: .8rem;
  }
  .zwc__coffret-title{
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.25; margin-bottom: 1rem;
  }
  .zwc__coffret-text{ font-size: .98rem; line-height: 1.75; opacity: .85; margin-bottom: 1.8rem; }
  .zwc__coffret-btn{
    display: inline-block; padding: .95rem 2.2rem;
    border: 1px solid #c9a35c; background: transparent; color: inherit;
    font-size: .7rem; font-weight: 600; text-transform: uppercase;
    letter-spacing: .22em; text-decoration: none; transition: background .3s ease, color .3s ease;
  }
  .zwc__coffret-btn:hover{ background: #c9a35c; color: #241610; }
  @media (max-width: 989px){
    .zwc__grid{ grid-template-columns: repeat(2, 1fr); }
    .zwc__coffret{ grid-template-columns: 1fr; gap: 1.8rem; padding: 1.8rem; }
  }
  @media (max-width: 549px){
    .zwc__grid{ grid-template-columns: 1fr; }
  }
</style>

{% schema %}
{
  "name": "Choisir sa recette",
  "tag": "section",
  "class": "section-choisir-recette",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Palette", "default": "creme",
      "options": [ { "value": "creme", "label": "Crème" }, { "value": "cafe", "label": "Café foncé" } ] },
    { "type": "text", "id": "kicker", "label": "Sur-titre" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Comment choisir *ta recette ?*" },
    { "type": "textarea", "id": "text", "label": "Introduction" },
    { "type": "text", "id": "card_cta", "label": "Libellé bouton carte", "default": "Découvrir" },
    { "type": "header", "content": "Bandeau Coffret Découverte" },
    { "type": "checkbox", "id": "show_coffret", "label": "Afficher le bandeau coffret", "default": true },
    { "type": "image_picker", "id": "coffret_image", "label": "Image du coffret" },
    { "type": "text", "id": "coffret_asset", "label": "Image asset (si pas d'image choisie)", "default": "coffret-ouvert.jpg" },
    { "type": "text", "id": "coffret_kicker", "label": "Sur-titre coffret", "default": "Pas encore sûr(e) de ton choix ?" },
    { "type": "text", "id": "coffret_title", "label": "Titre coffret", "default": "Le Coffret Découverte" },
    { "type": "textarea", "id": "coffret_text", "label": "Texte coffret",
      "default": "Les 4 recettes réunies — 3 sachets de chacune, 12 au total. Le meilleur point de départ pour trouver la tienne." },
    { "type": "text", "id": "coffret_cta_label", "label": "Libellé bouton coffret", "default": "Découvrir le coffret" },
    { "type": "url", "id": "coffret_cta_link", "label": "Lien bouton coffret" }
  ],
  "blocks": [
    {
      "type": "recette",
      "name": "Recette",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (sachet)" },
        { "type": "text", "id": "asset_fallback", "label": "Image asset (si pas d'image choisie)" },
        { "type": "text", "id": "name", "label": "Nom de la recette" },
        { "type": "text", "id": "badge", "label": "Badge (ex : ✦ Signature, Premium)" },
        { "type": "textarea", "id": "accroche", "label": "Accroche émotionnelle (« Tu… »)" },
        { "type": "text", "id": "epices", "label": "Épices (composition)" },
        { "type": "url", "id": "link", "label": "Lien vers la fiche produit" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Choisir sa recette",
      "blocks": [
        { "type": "recette", "settings": { "asset_fallback": "sachet-casablanca-v2.jpg", "name": "Aube de Casablanca", "badge": "", "accroche": "Tu aimes commencer la journée doucement. Douceur matinale, sans brusquer personne.", "epices": "Anis vert · Vanille Bourbon" } },
        { "type": "recette", "settings": { "asset_fallback": "sachet-rabat-v2.jpg", "name": "Grâce de Rabat", "badge": "✦ Signature", "accroche": "Tu cherches le réconfort dans ta tasse. Chaleur enveloppante. La recette de la mère du fondateur.", "epices": "Cardamome · Miel d'acacia" } },
        { "type": "recette", "settings": { "asset_fallback": "sachet-fes-v2.jpg", "name": "Âme de Fès", "badge": "Premium", "accroche": "Tu prends le temps de savourer. Floral et contemplatif. Pour les moments qui méritent d'être vécus lentement.", "epices": "Rose Damascena · Safran" } },
        { "type": "recette", "settings": { "asset_fallback": "sachet-marrakech-v2.jpg", "name": "Fièvre de Marrakech", "badge": "", "accroche": "Tu n'as pas peur de l'intensité. Franc, sans détour, sans excuse.", "epices": "Poivre · Cacao · Clou de girofle" } }
      ]
    }
  ]
}
{% endschema %}
