{% comment %}
  Zahowa — Footer Premium
  Design sombre élégant, doré, typographique.
{% endcomment %}

{%- liquid
  assign is_dark = true
  if section.settings.color_scheme == 'cream'
    assign is_dark = false
  endif
-%}

<style>
  #section-{{ section.id }}.zh-footer {
    background: var(--zw-coffee-950, #241610);
    color: var(--zw-cream-text, #efe6d8);
    padding: clamp(3.5rem, 8vw, 6rem) 0 2rem;
  }

  #section-{{ section.id }} .zh-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  #section-{{ section.id }} .zh-footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.75rem;
  }

  /* --- Colonne marque --- */
  #section-{{ section.id }} .zh-footer__brand {
    max-width: 320px;
  }

  #section-{{ section.id }} .zh-footer__logo {
    display: block;
    max-width: 180px;
    height: auto;
  }

  #section-{{ section.id }} .zh-footer__logo-img {
    width: 100%;
    height: auto;
    display: block;
  }

  #section-{{ section.id }} .zh-footer__brand-name {
    font-family: var(--zw-font-display, "Cormorant Garamond", Georgia, serif);
    font-weight: 500;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--zw-cream-text, #efe6d8);
    margin: 0;
  }

  #section-{{ section.id }} .zh-footer__tagline {
    margin: 0.9rem 0 0;
    font-family: var(--zw-font-display, "Cormorant Garamond", Georgia, serif);
    font-style: italic;
    font-weight: 500;
    font-size: 1.15rem;
    line-height: 1.5;
    color: var(--zw-cream-muted, #a0968a);
  }

  /* --- Réseaux sociaux --- */
  #section-{{ section.id }} .zh-footer__social {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  #section-{{ section.id }} .zh-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid color-mix(in srgb, var(--zw-gold-400, #c9a35c) 35%, transparent);
    border-radius: 50%;
    color: var(--zw-gold-400, #c9a35c);
    transition: color 0.3s ease, border-color 0.3s ease, transform 0.3s ease;
  }

  #section-{{ section.id }} .zh-footer__social-link:hover,
  #section-{{ section.id }} .zh-footer__social-link:focus-visible {
    color: var(--zw-coffee-950, #241610);
    background: var(--zw-gold-400, #c9a35c);
    border-color: var(--zw-gold-400, #c9a35c);
    transform: translateY(-2px);
  }

  /* --- Paiements --- */
  #section-{{ section.id }} .zh-footer__payments {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #section-{{ section.id }} .zh-footer__payment-icon {
    display: block;
    width: auto;
    height: 1.6rem;
    border-radius: 3px;
    overflow: hidden;
  }

  #section-{{ section.id }} .zh-footer__payment-icon svg {
    display: block;
    width: auto;
    height: 100%;
  }

  /* --- Colonnes --- */
  #section-{{ section.id }} .zh-footer__heading {
    margin: 0 0 1.1rem;
    font-family: var(--zw-font-body, "Jost", sans-serif);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--zw-gold-400, #c9a35c);
  }

  #section-{{ section.id }} .zh-footer__menu {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #section-{{ section.id }} .zh-footer__menu-link {
    display: inline-block;
    padding-block: 0.35rem;
    font-family: var(--zw-font-body, "Jost", sans-serif);
    font-size: 0.95rem;
    color: var(--zw-cream-muted, #a0968a);
    text-decoration: none;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  #section-{{ section.id }} .zh-footer__menu-link:hover,
  #section-{{ section.id }} .zh-footer__menu-link:focus-visible {
    color: var(--zw-gold-400, #c9a35c);
    transform: translateX(3px);
  }

  /* --- Barre basse --- */
  #section-{{ section.id }} .zh-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 3.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid color-mix(in srgb, var(--zw-gold-400, #c9a35c) 12%, transparent);
    font-family: var(--zw-font-body, "Jost", sans-serif);
    font-size: 0.78rem;
    color: var(--zw-cream-muted, #a0968a);
  }

  #section-{{ section.id }} .zh-footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #section-{{ section.id }} .zh-footer__legal-link {
    color: var(--zw-cream-muted, #a0968a);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  #section-{{ section.id }} .zh-footer__legal-link:hover,
  #section-{{ section.id }} .zh-footer__legal-link:focus-visible {
    color: var(--zw-gold-400, #c9a35c);
  }

  #section-{{ section.id }} .zh-footer__payment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #section-{{ section.id }} .zh-footer__payment svg {
    width: 2.4rem;
    height: 1.5rem;
    filter: grayscale(1) brightness(1.8);
    opacity: 0.85;
  }

  /* ===== Variante Cream ===== */
  #section-{{ section.id }}.zh-footer--cream {
    background: var(--zw-cream-50, #f5f0e8);
    color: var(--zw-ink-900, #241610);
  }

  #section-{{ section.id }}.zh-footer--cream .zh-footer__brand-name {
    color: var(--zw-ink-900, #241610);
  }

  #section-{{ section.id }}.zh-footer--cream .zh-footer__tagline {
    color: var(--zw-ink-500, #6b6057);
  }

  #section-{{ section.id }}.zh-footer--cream .zh-footer__heading {
    color: var(--zw-gold-600, #b8954a);
  }

  #section-{{ section.id }}.zh-footer--cream .zh-footer__menu-link {
    color: var(--zw-ink-500, #6b6057);
  }

  #section-{{ section.id }}.zh-footer--cream .zh-footer__menu-link:hover,
  #section-{{ section.id }}.zh-footer--cream .zh-footer__menu-link:focus-visible {
    color: var(--zw-gold-600, #b8954a);
  }

  #section-{{ section.id }}.zh-footer--cream .zh-footer__bottom {
    border-top-color: color-mix(in srgb, var(--zw-gold-600, #b8954a) 12%, transparent);
    color: var(--zw-ink-500, #6b6057);
  }

  #section-{{ section.id }}.zh-footer--cream .zh-footer__legal-link {
    color: var(--zw-ink-500, #6b6057);
  }

  #section-{{ section.id }}.zh-footer--cream .zh-footer__legal-link:hover,
  #section-{{ section.id }}.zh-footer--cream .zh-footer__legal-link:focus-visible {
    color: var(--zw-gold-600, #b8954a);
  }

  #section-{{ section.id }}.zh-footer--cream .zh-footer__copyright {
    color: var(--zw-ink-500, #6b6057);
  }

  #section-{{ section.id }}.zh-footer--cream .zh-footer__social-link {
    border-color: color-mix(in srgb, var(--zw-gold-600, #b8954a) 35%, transparent);
    color: var(--zw-gold-600, #b8954a);
  }

  #section-{{ section.id }}.zh-footer--cream .zh-footer__social-link:hover,
  #section-{{ section.id }}.zh-footer--cream .zh-footer__social-link:focus-visible {
    background: var(--zw-gold-600, #b8954a);
    border-color: var(--zw-gold-600, #b8954a);
    color: var(--zw-cream-50, #f5f0e8);
  }

  #section-{{ section.id }}.zh-footer--cream .zh-footer__payment-icon {
    background: var(--zw-cream-50, #f5f0e8);
  }

  /* Responsive */
  @media (min-width: 750px) {
    #section-{{ section.id }} .zh-footer__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3rem;
    }

    #section-{{ section.id }} .zh-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
  }

  @media (min-width: 990px) {
    #section-{{ section.id }} .zh-footer__grid {
      grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
      gap: 3.5rem;
    }
  }
</style>

<footer id="section-{{ section.id }}" class="zh-footer{% if is_dark %} zh-footer--dark{% else %} zh-footer--cream{% endif %}" role="contentinfo">
  <div class="zh-container">
    <div class="zh-footer__grid">
      {%- comment -%} Colonne marque {%- endcomment -%}
      <div class="zh-footer__brand">
        {%- if section.settings.logo != blank -%}
          <a href="/" class="zh-footer__logo" aria-label="{{ shop.name | escape }}">
            <img
              class="zh-footer__logo-img"
              src="{{ section.settings.logo | image_url: width: 180 }}"
              srcset="{{ section.settings.logo | image_url: width: 180 }} 180w, {{ section.settings.logo | image_url: width: 360 }} 360w"
              sizes="180px"
              alt="{{ shop.name | escape }}"
              loading="lazy"
            >
          </a>
        {%- else -%}
          <p class="zh-footer__brand-name">{{ shop.name }}</p>
        {%- endif -%}

        {%- if section.settings.tagline != blank -%}
          <p class="zh-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- comment -%} Réseaux sociaux (snippet partagé) {%- endcomment -%}
        {% render 'social-links', class: 'zh-footer__social' %}
      </div>

      {%- comment -%} Blocs colonnes (max 3) {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="zh-footer__column" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="zh-footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
                <ul class="zh-footer__menu" role="list">
                  {%- for link in linklists[block.settings.menu].links -%}
                    <li>
                      <a class="zh-footer__menu-link" href="{{ link.url }}">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>

          {%- when 'payment' -%}
            {%- liquid
              assign show_visa = block.settings.show_visa
              assign show_mastercard = block.settings.show_mastercard
              assign show_paypal = block.settings.show_paypal
              assign show_apple_pay = block.settings.show_apple_pay
              assign show_google_pay = block.settings.show_google_pay
              assign show_amex = block.settings.show_amex
              assign has_payment = false
              if show_visa or show_mastercard or show_paypal or show_apple_pay or show_google_pay or show_amex
                assign has_payment = true
              endif
            -%}
            {%- if has_payment -%}
              <div class="zh-footer__column" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="zh-footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <ul class="zh-footer__payments" role="list" aria-label="Moyens de paiement acceptés">
                  {%- if show_visa -%}
                    <li class="zh-footer__payment-icon" aria-label="Visa">
                      <svg viewBox="0 0 48 32" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="48" height="32" rx="4" fill="#f5f0e8"/><text x="24" y="21" text-anchor="middle" fill="#1A1F71" font-size="12" font-weight="bold" font-style="italic" font-family="Arial, Helvetica, sans-serif">VISA</text></svg>
                    </li>
                  {%- endif -%}
                  {%- if show_mastercard -%}
                    <li class="zh-footer__payment-icon" aria-label="MasterCard">
                      <svg viewBox="0 0 48 32" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="48" height="32" rx="4" fill="#f5f0e8"/><circle cx="19" cy="16" r="8" fill="#EB001B" opacity="0.9"/><circle cx="29" cy="16" r="8" fill="#F79E1B" opacity="0.9"/></svg>
                    </li>
                  {%- endif -%}
                  {%- if show_paypal -%}
                    <li class="zh-footer__payment-icon" aria-label="PayPal">
                      <svg viewBox="0 0 48 32" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="48" height="32" rx="4" fill="#f5f0e8"/><text x="24" y="21" text-anchor="middle" fill="#003087" font-size="11" font-weight="bold" font-family="Arial, Helvetica, sans-serif">PayPal</text></svg>
                    </li>
                  {%- endif -%}
                  {%- if show_apple_pay -%}
                    <li class="zh-footer__payment-icon" aria-label="Apple Pay">
                      <svg viewBox="0 0 48 32" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="48" height="32" rx="4" fill="#f5f0e8"/><text x="24" y="21" text-anchor="middle" fill="#000" font-size="10" font-weight="bold" font-family="Arial, Helvetica, sans-serif">Pay</text></svg>
                    </li>
                  {%- endif -%}
                  {%- if show_google_pay -%}
                    <li class="zh-footer__payment-icon" aria-label="Google Pay">
                      <svg viewBox="0 0 48 32" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="48" height="32" rx="4" fill="#f5f0e8"/><text x="24" y="21" text-anchor="middle" fill="#333" font-size="10" font-weight="bold" font-family="Arial, Helvetica, sans-serif">G Pay</text></svg>
                    </li>
                  {%- endif -%}
                  {%- if show_amex -%}
                    <li class="zh-footer__payment-icon" aria-label="American Express">
                      <svg viewBox="0 0 48 32" fill="none" xmlns="http://www.w3.org/2000/svg"><rect width="48" height="32" rx="4" fill="#016FD0"/><text x="24" y="21" text-anchor="middle" fill="#fff" font-size="9" font-weight="bold" font-family="Arial, Helvetica, sans-serif">AMEX</text></svg>
                    </li>
                  {%- endif -%}
                </ul>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- comment -%} Barre basse {%- endcomment -%}
    <div class="zh-footer__bottom">
      <p class="zh-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }} — Tous droits réservés
      </p>

      {%- assign has_policies = false -%}
      {%- if shop.privacy_policy != blank or shop.terms_of_service != blank or shop.refund_policy != blank -%}
        {%- assign has_policies = true -%}
      {%- endif -%}

      {%- if has_policies -%}
        <ul class="zh-footer__legal" role="list">
          {%- if shop.privacy_policy != blank -%}
            <li><a class="zh-footer__legal-link" href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>
          {%- endif -%}
          {%- if shop.terms_of_service != blank -%}
            <li><a class="zh-footer__legal-link" href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>
          {%- endif -%}
          {%- if shop.refund_policy != blank -%}
            <li><a class="zh-footer__legal-link" href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_payment_icons and shop.enabled_payment_types != blank -%}
        <ul class="zh-footer__payment" role="list" aria-label="Moyens de paiement acceptés">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page Zahowa",
  "max_blocks": 3,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Style du panneau texte",
      "default": "dark",
      "options": [
        { "value": "dark", "label": "Café (foncé)" },
        { "value": "cream", "label": "Crème" }
      ]
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (remplace le nom du shop)"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Baseline",
      "default": "Un café épicé, comme tu ne l'as jamais bu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Afficher les icônes de paiement (barre basse)",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Colonne menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Découvrir"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "payment",
      "name": "Colonne paiement",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Titre",
          "default": "Paiement"
        },
        {
          "type": "checkbox",
          "id": "show_visa",
          "label": "Visa",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_mastercard",
          "label": "MasterCard",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_paypal",
          "label": "PayPal",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_apple_pay",
          "label": "Apple Pay",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_google_pay",
          "label": "Google Pay",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_amex",
          "label": "American Express",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pied de page Zahowa",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "Menu"
          }
        },
        {
          "type": "payment",
          "settings": {
            "heading": "Paiement",
            "show_visa": true,
            "show_mastercard": true,
            "show_paypal": true
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Suivre"
          }
        }
      ]
    }
  ]
}
{% endschema %}
