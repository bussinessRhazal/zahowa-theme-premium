{{ 'new-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign use_metafield = false
  if section.settings.source == 'metafield' and product != blank
    assign spices = product.metafields.custom.spices.value
    if spices != blank and spices.size > 0
      assign use_metafield = true
    endif
  endif
-%}

<section
  class="zw-scheme-{{ section.settings.color_scheme }} section spices"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    <div class="section__header" data-reveal>
      {% if section.settings.heading != blank %}
        <h2 class="section__title">
          {{ section.settings.heading | replace_first: '*', '<em class="section__title-accent">' | replace_first: '*', '</em>' }}
        </h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="section__intro">{{ section.settings.subheading }}</p>
      {% endif %}
      <span class="section__rule">{% render 'icon', name: 'diamond' %}</span>
    </div>

    {% if use_metafield %}
      <ul class="spices__grid" role="list">
        {% for spice in spices %}
          <li class="spices__item" data-reveal>
            {% if spice.image.value != blank %}
              <div class="spices__media">
                {{ spice.image.value | image_url: width: 320 | image_tag: loading: 'lazy', class: 'spices__image', widths: '160, 240, 320', sizes: '112px', alt: spice.name.value }}
              </div>
            {% endif %}
            <h3 class="spices__name">{{ spice.name.value }}</h3>
            {% if spice.origin.value != blank %}
              <p class="spices__origin">{{ spice.origin.value }}</p>
            {% endif %}
            {% if spice.note.value != blank %}
              <p class="spices__note">{{ spice.note.value }}</p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% elsif section.blocks.size > 0 %}
      <ul class="spices__grid" role="list">
        {% for block in section.blocks %}
          <li class="spices__item" data-reveal {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="spices__media">
                {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', class: 'spices__image', widths: '160, 240, 320', sizes: '112px', alt: block.settings.name }}
              </div>
            {% endif %}
            <h3 class="spices__name">{{ block.settings.name }}</h3>
            {% if block.settings.origin != blank %}
              <p class="spices__origin">{{ block.settings.origin }}</p>
            {% endif %}
            {% if block.settings.note != blank %}
              <p class="spices__note">{{ block.settings.note }}</p>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <div class="empty-state">Ajoutez des épices via le metafield produit ou des blocks.</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Épices de la recette",
  "tag": "section",
  "class": "section-ingredients-spices",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleur de fond",
      "options": [
        { "value": "creme", "label": "Crème (clair)" },
        { "value": "cafe", "label": "Café foncé (sombre)" }
      ],
      "default": "cafe"
    },
    { "type": "text", "id": "heading", "label": "Titre", "default": "L'*assemblage*" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Chaque épice est sélectionnée à la source et dosée au gramme près."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Source des épices",
      "options": [
        { "value": "metafield", "label": "Metafield produit (custom.spices)" },
        { "value": "blocks", "label": "Blocks manuels" }
      ],
      "default": "metafield",
      "info": "Si le metafield est vide, les blocks manuels sont utilisés automatiquement."
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacement haut",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacement bas",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "spice",
      "name": "Épice",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (pastille ronde, 1:1)" },
        { "type": "text", "id": "name", "label": "Nom", "default": "Cardamome verte" },
        { "type": "text", "id": "origin", "label": "Origine", "default": "Hauts plateaux, Guatemala" },
        { "type": "text", "id": "note", "label": "Note aromatique", "default": "Fraîcheur citronnée" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Épices de la recette",
      "blocks": [
        { "type": "spice" },
        { "type": "spice", "settings": { "name": "Cannelle de Ceylan", "origin": "Sri Lanka", "note": "Chaleur douce et boisée" } },
        { "type": "spice", "settings": { "name": "Gingembre", "origin": "Kerala, Inde", "note": "Piquant vivifiant" } }
      ]
    }
  ]
}
{% endschema %}
