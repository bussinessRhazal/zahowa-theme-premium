<section class="zw-scheme-{{ section.settings.color_scheme }} section{% if section.settings.alt_bg %} section--alt{% endif %}" {% if section.settings.id != blank %}id="{{ section.settings.id }}"{% endif %}>
  <div class="container">
    <div class="coffret{% if section.settings.reverse %} coffret--reverse{% endif %}">
      <div class="coffret__grid">
        <div class="coffret__media" data-reveal>
          {% if section.settings.image != blank %}
            {% assign coffret_alt = section.settings.image.alt | escape | default: section.settings.title %}
            {{ section.settings.image | image_url: width: 1400 | image_tag: alt: coffret_alt, loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw' }}
          {% else %}
            <div class="coffret__placeholder"></div>
          {% endif %}
        </div>
        <div class="coffret__content" data-reveal>
          {% if section.settings.kicker != blank %}
            <p class="coffret__kicker">{{ section.settings.kicker }}</p>
          {% endif %}
          {% if section.settings.title != blank %}
            <h2 class="coffret__title">
              {{ section.settings.title | replace_first: '*', '<em class="section__title-accent">' | replace_first: '*', '</em>' }}
            </h2>
          {% endif %}
          {% if section.settings.text != blank %}
            <div class="coffret__text">{{ section.settings.text }}</div>
          {% endif %}
          {% if section.settings.button_label != blank %}
            <a href="{{ section.settings.button_link | default: routes.root_url }}" class="btn btn--primary">
              {{ section.settings.button_label }}
              {% render 'icon', name: 'arrow' %}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.coffret.name",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleur de fond",
      "options": [
        {
          "value": "creme",
          "label": "Crème (clair)"
        },
        {
          "value": "cafe",
          "label": "Café foncé (sombre)"
        }
      ],
      "default": "creme"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.coffret.image_label"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.coffret.kicker_label",
      "default": "L'idée cadeau"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.coffret.title_label",
      "default": "Coffret *Découverte*"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.coffret.text_label",
      "default": "<p>Quatre villes. Quatre caractères. Une expérience à offrir ou à s'offrir. Une boîte précieuse, des sachets biodégradables, un rituel à partager.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.coffret.button_label",
      "default": "Découvrir le coffret"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.coffret.button_link"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "t:sections.coffret.reverse_label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "alt_bg",
      "label": "t:sections.maison.alt_bg_label",
      "default": false
    },
    {
      "type": "text",
      "id": "id",
      "label": "t:sections.hero.anchor_label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.coffret.name"
    }
  ]
}
{% endschema %}
