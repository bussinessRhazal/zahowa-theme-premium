<section class="zw-scheme-{{ section.settings.color_scheme }} section faq{% if section.settings.alt_bg %} section--alt{% endif %}" {% if section.settings.id != blank %}id="{{ section.settings.id }}"{% endif %}>
  <div class="container">
    <div class="section__header" data-reveal>
      {% if section.settings.kicker != blank %}
        <p class="section__kicker">{{ section.settings.kicker }}</p>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="section__title">
          {{ section.settings.title | replace_first: '*', '<em class="section__title-accent">' | replace_first: '*', '</em>' }}
        </h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="section__intro">{{ section.settings.text }}</p>
      {% endif %}
      <span class="section__rule">{% render 'icon', name: 'diamond' %}</span>
    </div>

        {%- if section.blocks.size > 0 -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- for block in section.blocks -%}
              {
                "@type": "Question",
                "name": {{ block.settings.question | json }},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{ block.settings.answer | strip_html | json }}
                }
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}

    {% if section.blocks.size > 0 %}
      <div class="faq__list" data-reveal>
        {% for block in section.blocks %}
          <details class="faq__item" {% if section.settings.open_first and forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="faq__question">
              {{ block.settings.question }}
              {% render 'icon', name: 'chevron' %}
            </summary>
            <div class="faq__answer">{{ block.settings.answer }}</div>
          </details>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.faq.name",
  "max_blocks": 10,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleur de fond",
      "options": [
        {
          "value": "creme",
          "label": "Crème (clair)"
        },
        {
          "value": "cafe",
          "label": "Café foncé (sombre)"
        }
      ],
      "default": "creme"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.maison.kicker_label",
      "default": "Questions fréquentes"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.rich_text.title_label",
      "default": "Vos *questions*"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.rich_text.text_label"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "t:sections.faq.open_first_label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "alt_bg",
      "label": "t:sections.maison.alt_bg_label",
      "default": false
    },
    {
      "type": "text",
      "id": "id",
      "label": "t:sections.hero.anchor_label"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.block_name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq.question_label",
          "default": "Comment utiliser un drip bag Zahowa ?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq.answer_label",
          "default": "<p>Ouvrez le sachet, installez les ailes sur votre tasse, versez lentement 200 ml d'eau chaude (92–96°C) et laissez infuser 3 à 4 minutes. C'est tout !</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.name",
      "blocks": [
        {
          "type": "question"
        },
        {
          "type": "question"
        },
        {
          "type": "question"
        }
      ]
    }
  ]
}
{% endschema %}
