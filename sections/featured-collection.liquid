<section class="section{% if section.settings.alt_bg %} section--alt{% endif %}" {% if section.settings.id != blank %}id="{{ section.settings.id }}"{% endif %}>
  <div class="container">
    <div class="section__header" data-reveal>
      {% if section.settings.kicker != blank %}
        <p class="section__kicker">{{ section.settings.kicker }}</p>
      {% endif %}
      {% if section.settings.title != blank %}
        <h2 class="section__title">
          {{ section.settings.title | replace_first: '*', '<em class="section__title-accent">' | replace_first: '*', '</em>' }}
        </h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="section__intro">{{ section.settings.text }}</p>
      {% endif %}
      <span class="section__rule">{% render 'icon', name: 'diamond' %}</span>
    </div>

    {% assign collection = section.settings.collection %}
    {% if collection != blank and collection.products.size > 0 %}
      <div class="collection-grid">
        {% for product in collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', product: product, portrait: section.settings.portrait %}
        {% endfor %}
      </div>

      {% if section.settings.show_view_all and collection.products.size > section.settings.products_to_show %}
        <div class="section__footer-cta" style="text-align:center;margin-top:2.5rem;">
          <a href="{{ collection.url }}" class="btn btn--outline">
            {{ 'sections.featured_collection.view_all' | t }}
            {% render 'icon', name: 'arrow' %}
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="empty-state">{{ 'sections.main_collection.empty' | t }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.collection_label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.featured_collection.products_label",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.featured_collection.kicker_label",
      "default": "Nos créations"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.featured_collection.title_label",
      "default": "Nos *Recettes*"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.featured_collection.text_label"
    },
    {
      "type": "checkbox",
      "id": "portrait",
      "label": "t:sections.featured_collection.portrait_label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collection.show_view_all_label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "alt_bg",
      "label": "t:sections.maison.alt_bg_label",
      "default": false
    },
    {
      "type": "text",
      "id": "id",
      "label": "t:sections.hero.anchor_label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name"
    }
  ]
}
{% endschema %}
