{%- comment -%} Section : Manifeste & Rituel — page Nos Recettes {%- endcomment -%}
<section class="section zw-scheme-{{ section.settings.color_scheme }} zws" id="section-{{ section.id }}">
  <div class="container">
    <div class="section__header" data-reveal>
      {% if section.settings.kicker != blank %}<p class="section__kicker">{{ section.settings.kicker }}</p>{% endif %}
      {% if section.settings.title != blank %}
        <h2 class="section__title">{{ section.settings.title | replace_first: '*', '<em class="section__title-accent">' | replace_first: '*', '</em>' }}</h2>
      {% endif %}
      <span class="section__rule">{% render 'icon', name: 'diamond' %}</span>
    </div>

    {% if section.settings.manifesto != blank %}
      <p class="zws__manifesto" data-reveal>{{ section.settings.manifesto }}</p>
    {% endif %}
    {% if section.settings.manifesto_alt != blank %}
      <p class="zws__manifesto-sub" data-reveal>{{ section.settings.manifesto_alt }}</p>
    {% endif %}

    <div class="zws__rituel" data-reveal>
      {% if section.settings.rituel_title != blank %}
        <h3 class="zws__rituel-title">{{ section.settings.rituel_title }}</h3>
      {% endif %}
      <div class="zws__steps">
        {% for block in section.blocks %}
          <div class="zws__step" {{ block.shopify_attributes }}>
            <span class="zws__step-num">{{ block.settings.numeral }}</span>
            <span class="zws__step-rule"></span>
            <h4 class="zws__step-title">{{ block.settings.title }}</h4>
            {% if block.settings.text != blank %}<p class="zws__step-text">{{ block.settings.text }}</p>{% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
  .zws__manifesto{
    max-width: 52rem; margin: 0 auto; text-align: center;
    font-family: var(--font-display); font-style: italic;
    font-size: clamp(1.35rem, 2.4vw, 1.9rem); line-height: 1.55;
    color: var(--color-coffee, #241610);
  }
  .zws__manifesto-sub{
    max-width: 46rem; margin: 1.75rem auto 0; text-align: center;
    font-size: 1rem; line-height: 1.8; opacity: .82;
  }
  .zws__rituel{ margin-top: 4.5rem; }
  .zws__rituel-title{
    text-align: center; font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.2vw, 1.8rem); font-weight: 500;
    letter-spacing: .04em; margin-bottom: 3rem;
  }
  .zws__steps{
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem; max-width: 62rem; margin: 0 auto;
  }
  .zws__step{ text-align: center; }
  .zws__step-num{
    display: block; font-family: var(--font-display); font-style: italic;
    font-size: 2.2rem; color: var(--color-gold-dark, #a5823f); line-height: 1;
  }
  .zws__step-rule{
    display: block; width: 3rem; height: 1px; margin: 1.1rem auto;
    background: var(--color-gold, #c9a35c);
  }
  .zws__step-title{
    font-family: var(--font-body); font-size: .8rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: .22em; margin-bottom: .6rem;
  }
  .zws__step-text{ font-size: .95rem; line-height: 1.7; opacity: .8; }
  @media (max-width: 749px){
    .zws__steps{ grid-template-columns: 1fr; gap: 2rem; }
    .zws__step-rule{ margin: .9rem auto; }
  }
</style>

{% schema %}
{
  "name": "Manifeste & Rituel",
  "tag": "section",
  "class": "section-manifeste-rituel",
  "settings": [
    { "type": "select", "id": "color_scheme", "label": "Palette", "default": "creme",
      "options": [ { "value": "creme", "label": "Crème" }, { "value": "cafe", "label": "Café foncé" } ] },
    { "type": "text", "id": "kicker", "label": "Sur-titre", "default": "Nos Recettes" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Quatre épices. Quatre villes. *Un rituel.*" },
    { "type": "textarea", "id": "manifesto", "label": "Manifeste (grand texte)",
      "default": "Chaque recette Zahowa est née d'un équilibre précis entre un café Arabica de spécialité et des épices naturelles sélectionnées. Pas d'arôme artificiel. Pas de sucre ajouté. Juste le café — et ce qui lui donne une âme." },
    { "type": "textarea", "id": "manifesto_alt", "label": "Texte secondaire (format)",
      "default": "Le format sachet mousseline biodégradable (certifié OK Compost HOME) fait le reste : 92°C, 5 à 6 minutes, sans machine. Le même geste que ton thé du matin — avec un résultat que tu n'attendais pas." },
    { "type": "text", "id": "rituel_title", "label": "Titre du rituel", "default": "Le rituel" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "text", "id": "numeral", "label": "Numéro", "default": "I" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Infuser" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Plonge le sachet dans l'eau à 92°C." }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Manifeste & Rituel",
      "blocks": [
        { "type": "step", "settings": { "numeral": "I", "title": "Infuser", "text": "Plonge le sachet mousseline dans l'eau frémissante, à 92°C." } },
        { "type": "step", "settings": { "numeral": "II", "title": "Patienter", "text": "Laisse le café et les épices se rencontrer, 5 à 6 minutes." } },
        { "type": "step", "settings": { "numeral": "III", "title": "Déguster", "text": "Retire le sachet. Respire. Le rituel commence." } }
      ]
    }
  ]
}
{% endschema %}

{% comment %} sync-bump-1 {% endcomment %}
