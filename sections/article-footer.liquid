{%- comment -%}
  Zahowa — Pied d'article
  Navigation article précédent / suivant + boutons de partage.
{%- endcomment -%}

{%- liquid
  assign is_dark = true
  if section.settings.color_scheme == 'cream'
    assign is_dark = false
  endif

  if blog.next_article or blog.previous_article
    assign has_nav = true
  endif
-%}

{%- style -%}
  #section-{{ section.id }} {
    {% if is_dark %}
      --zh-art-bg: var(--zw-coffee-950, #241610);
      --zh-art-text: var(--zw-cream-text, #efe6d8);
      --zh-art-muted: var(--zw-cream-muted, #a0968a);
      --zh-art-accent: var(--zw-gold-400, #c9a35c);
      --zh-art-border: rgba(201, 163, 92, 0.12);
    {% else %}
      --zh-art-bg: var(--zw-cream-50, #f5f0e8);
      --zh-art-text: var(--zw-ink-900, #241610);
      --zh-art-muted: var(--zw-ink-500, #6b6057);
      --zh-art-accent: var(--zw-gold-600, #b8954a);
      --zh-art-border: rgba(184, 149, 74, 0.15);
    {% endif %}
    background-color: var(--zh-art-bg);
    color: var(--zh-art-text);
  }

  #section-{{ section.id }} .zh-article-footer {
    font-family: var(--zw-font-body, 'Jost', system-ui, sans-serif);
    -webkit-font-smoothing: antialiased;
    padding: 0 1.5rem clamp(3rem, 6vw, 5rem);
  }

  #section-{{ section.id }} .zh-article-footer__inner {
    max-width: 720px;
    margin: 0 auto;
  }

  /* Partage */
  #section-{{ section.id }} .zh-article-footer__share {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding-bottom: 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--zh-art-border);
  }
  #section-{{ section.id }} .zh-article-footer__share-label {
    font-family: var(--zw-font-body, 'Jost', sans-serif);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--zh-art-muted);
  }
  #section-{{ section.id }} .zh-article-footer__share-links {
    display: flex;
    gap: 0.5rem;
  }
  #section-{{ section.id }} .zh-article-footer__share-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--zh-art-border);
    color: var(--zh-art-muted);
    transition: all var(--zw-transition);
  }
  #section-{{ section.id }} .zh-article-footer__share-btn:hover {
    border-color: var(--zh-art-accent);
    color: var(--zh-art-accent);
  }
  #section-{{ section.id }} .zh-article-footer__share-btn svg {
    width: 14px;
    height: 14px;
  }

  /* Navigation */
  #section-{{ section.id }} .zh-article-footer__nav {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    #section-{{ section.id }} .zh-article-footer__nav {
      grid-template-columns: 1fr 1fr;
    }
  }

  #section-{{ section.id }} .zh-article-footer__nav-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    border: 1px solid var(--zh-art-border);
    text-decoration: none;
    transition: border-color var(--zw-transition);
  }
  #section-{{ section.id }} .zh-article-footer__nav-item:hover {
    border-color: var(--zh-art-accent);
  }
  #section-{{ section.id }} .zh-article-footer__nav-item--next {
    text-align: right;
    align-items: flex-end;
  }

  #section-{{ section.id }} .zh-article-footer__nav-label {
    font-family: var(--zw-font-body, 'Jost', sans-serif);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--zh-art-accent);
  }
  #section-{{ section.id }} .zh-article-footer__nav-title {
    font-family: var(--zw-font-display, 'Cormorant Garamond', Georgia, serif);
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    font-weight: 400;
    line-height: 1.3;
    color: var(--zh-art-text);
    margin: 0;
  }
{%- endstyle -%}

<div id="section-{{ section.id }}" class="zh-article-footer">
  <div class="zh-article-footer__inner">

    {%- if section.settings.show_share -%}
      <div class="zh-article-footer__share">
        <span class="zh-article-footer__share-label">Partager</span>
        <div class="zh-article-footer__share-links">
          {%- assign share_url = shop.url | append: article.url | url_encode -%}
          {%- assign share_title = article.title | url_encode -%}

          <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}"
             target="_blank" rel="noopener"
             class="zh-article-footer__share-btn"
             aria-label="Partager sur Facebook">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
          </a>
          <a href="https://twitter.com/intent/tweet?url={{ share_url }}&text={{ share_title }}"
             target="_blank" rel="noopener"
             class="zh-article-footer__share-btn"
             aria-label="Partager sur X">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          {%- if article.image != blank -%}
            <a href="https://pinterest.com/pin/create/button/?url={{ share_url }}&media={{ article.image | image_url: width: 800 }}&description={{ share_title }}"
               target="_blank" rel="noopener"
               class="zh-article-footer__share-btn"
               aria-label="Partager sur Pinterest">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
            </a>
          {%- endif -%}
          <a href="mailto:?subject={{ share_title }}&body={{ share_url }}"
             class="zh-article-footer__share-btn"
             aria-label="Partager par email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 7l-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/></svg>
          </a>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.show_nav and has_nav -%}
      <nav class="zh-article-footer__nav" aria-label="Navigation articles">
        {%- if blog.previous_article -%}
          <a href="{{ blog.previous_article.url }}" class="zh-article-footer__nav-item">
            <span class="zh-article-footer__nav-label">← Article précédent</span>
            <p class="zh-article-footer__nav-title">{{ blog.previous_article.title }}</p>
          </a>
        {%- else -%}
          <div></div>
        {%- endif -%}

        {%- if blog.next_article -%}
          <a href="{{ blog.next_article.url }}" class="zh-article-footer__nav-item zh-article-footer__nav-item--next">
            <span class="zh-article-footer__nav-label">Article suivant →</span>
            <p class="zh-article-footer__nav-title">{{ blog.next_article.title }}</p>
          </a>
        {%- else -%}
          <div></div>
        {%- endif -%}
      </nav>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Pied d'article Zahowa",
  "tag": "section",
  "class": "zh-section",
  "settings": [
    {
      "type": "header",
      "content": "Style du panneau"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Style du panneau",
      "default": "dark",
      "options": [
        { "value": "dark", "label": "Café (foncé)" },
        { "value": "cream", "label": "Crème" }
      ]
    },
    {
      "type": "header",
      "content": "Affichage"
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Boutons de partage",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_nav",
      "label": "Navigation précédent / suivant",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Pied d'article Zahowa",
      "category": "Zahowa"
    }
  ]
}
{% endschema %}
