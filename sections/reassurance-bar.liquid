{{ 'new-sections.css' | asset_url | stylesheet_tag }}

<section
  class="zw-scheme-{{ section.settings.color_scheme }} section reassurance{% if section.settings.show_top_border %} reassurance--bordered{% endif %}"
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    <ul class="reassurance__list" role="list" data-reveal>
      {% for block in section.blocks %}
        <li class="reassurance__item" {{ block.shopify_attributes }}>
          <span class="reassurance__icon">{% render 'icon', name: block.settings.icon %}</span>
          <div class="reassurance__content">
            <p class="reassurance__title">{{ block.settings.title }}</p>
            {% if block.settings.text != blank %}
              <p class="reassurance__text">{{ block.settings.text }}</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Barre de réassurance",
  "tag": "section",
  "class": "section-reassurance-bar",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleur de fond",
      "options": [
        { "value": "creme", "label": "Crème (clair)" },
        { "value": "cafe", "label": "Café foncé (sombre)" }
      ],
      "default": "creme"
    },
    {
      "type": "checkbox",
      "id": "show_top_border",
      "label": "Bordure dorée supérieure",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Espacement haut",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Espacement bas",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Argument",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "options": [
            { "value": "check", "label": "Livraison" },
            { "value": "lock", "label": "Paiement sécurisé" },
            { "value": "spark", "label": "Torréfaction artisanale" },
            { "value": "arrow", "label": "Retours" },
            { "value": "leaf", "label": "Ingrédients naturels" },
            { "value": "mail", "label": "Réponse rapide" }
          ],
          "default": "check"
        },
        { "type": "text", "id": "title", "label": "Titre", "default": "Livraison suivie en Europe" },
        { "type": "text", "id": "text", "label": "Texte secondaire", "default": "Offerte dès 49 €" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Barre de réassurance",
      "blocks": [
        { "type": "item", "settings": { "icon": "check", "title": "Livraison suivie en Europe", "text": "Offerte dès 49 €" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Paiement sécurisé", "text": "CB, PayPal, Apple Pay" } },
        { "type": "item", "settings": { "icon": "spark", "title": "Torréfaction artisanale", "text": "En petits lots" } },
        { "type": "item", "settings": { "icon": "arrow", "title": "Satisfait ou remboursé", "text": "30 jours" } }
      ]
    }
  ]
}
{% endschema %}
