<div class="zw-scheme-{{ section.settings.color_scheme }} announcement" {% if settings.enable_announcement == false %}hidden{% endif %}>
  <div class="container">
    {% if settings.announcement_link != blank %}
      <a href="{{ settings.announcement_link }}">
        {{ settings.announcement_text }}
      </a>
    {% else %}
      {{ settings.announcement_text }}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Couleur de fond",
      "options": [
        {
          "value": "creme",
          "label": "Crème (clair)"
        },
        {
          "value": "cafe",
          "label": "Café foncé (sombre)"
        }
      ],
      "default": "cafe"
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.name"
    }
  ]
}
{% endschema %}
