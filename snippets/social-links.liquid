{% doc %}
Renders the social links list from global theme settings.
@param {string} [class] - Base CSS class (default: social-links). Link class = {class}-link.
@example
{% render 'social-links' %}
{% render 'social-links', class: 'zh-footer__social' %}
{% enddoc %}
{%- assign social_class = class | default: 'social-links' -%}
{%- liquid
  assign has_social = false
  if settings.social_instagram_url != blank or settings.social_tiktok_url != blank or settings.social_facebook_url != blank or settings.social_linkedin_url != blank
    assign has_social = true
  endif
-%}
{%- if has_social -%}
  <ul class="{{ social_class }}" role="list">
    {%- if settings.social_instagram_url != blank -%}
      <li>
        <a class="{{ social_class }}-link" href="{{ settings.social_instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
          {% render 'icon', name: 'instagram' %}
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_tiktok_url != blank -%}
      <li>
        <a class="{{ social_class }}-link" href="{{ settings.social_tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">
          {% render 'icon', name: 'tiktok' %}
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_facebook_url != blank -%}
      <li>
        <a class="{{ social_class }}-link" href="{{ settings.social_facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
          {% render 'icon', name: 'facebook' %}
        </a>
      </li>
    {%- endif -%}
    {%- if settings.social_linkedin_url != blank -%}
      <li>
        <a class="{{ social_class }}-link" href="{{ settings.social_linkedin_url }}" target="_blank" rel="noopener" aria-label="LinkedIn">
          {% render 'icon', name: 'linkedin' %}
        </a>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}
