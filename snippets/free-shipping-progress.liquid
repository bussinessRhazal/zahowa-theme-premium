{% doc %}
Free shipping progress bar. Uses settings.free_shipping_threshold (€, 0 = disabled).
@param {object} cart - The cart object
@example
{% render 'free-shipping-progress', cart: cart %}
{% enddoc %}
{% if settings.free_shipping_threshold > 0 %}
  {% assign threshold_cents = settings.free_shipping_threshold | times: 100 %}
  {% assign remaining = threshold_cents | minus: cart.total_price %}
  <div class="free-ship" data-free-ship>
    {% if remaining > 0 %}
      {% assign remaining_money = remaining | money %}
      <p class="free-ship__text">{{ 'general.cart.free_shipping_progress' | t: amount: remaining_money }}</p>
      {% assign progress = cart.total_price | times: 100 | divided_by: threshold_cents %}
      <div class="free-ship__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}">
        <span style="width: {{ progress }}%;"></span>
      </div>
    {% else %}
      <p class="free-ship__text free-ship__text--met">{{ 'general.cart.free_shipping_met' | t }}</p>
      <div class="free-ship__bar free-ship__bar--met" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100">
        <span style="width: 100%;"></span>
      </div>
    {% endif %}
  </div>
{% endif %}
