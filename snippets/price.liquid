{% doc %}
Renders a product price block with compare-at support.
@param {product} product - The product to price
@example
{% render 'price', product: product %}
{% enddoc %}
{% if product != blank %}
  <div class="price" data-price-container>
    {% if product.compare_at_price > product.price %}
      <span class="price__regular price__regular--sale">{{ product.price | money }}</span>
      <span class="price__compare">{{ product.compare_at_price | money }}</span>
    {% else %}
      <span class="price__regular">{{ product.price | money }}</span>
    {% endif %}
  </div>
{% endif %}
