dius: 2px;\n  }\n  .zh-ritual__image::before {\n    content: \"\";\n    display: block;\n    padding-bottom: 120%;\n  }\n  .zh-ritual__image img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  .zh-ritual__text h2 {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    font-size: clamp(1.6rem, 3vw, 2.2rem);\n    font-weight: 400;\n    line-height: 1.2;\n    color: #241610;\n    margin: 0 0 1rem;\n  }\n  .zh-ritual__text h2 em {\n    color: #b8954a;\n    font-style: italic;\n  }\n  .zh-ritual__text p {\n    font-size: clamp(0.88rem, 1.1vw, 0.95rem);\n    line-height: 1.85;\n    color: #6b6057;\n    margin: 0 0 1.2rem;\n  }\n  .zh-ritual__text p:last-child {\n    margin-bottom: 0;\n  }\n\n  /* Steps */\n  .zh-ritual__steps {\n    list-style: none;\n    padding: 0;\n    margin: 2rem 0 0;\n  }\n  .zh-ritual__step {\n    display: flex;\n    align-items: baseline;\n    gap: 1.25rem;\n    padding: 1.1rem 0;\n    border-bottom: 1px solid rgba(184, 149, 74, 0.18);\n    font-size: clamp(0.88rem, 1.1vw, 0.95rem);\n    color: #6b6057;\n  }\n  .zh-ritual__step-num {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    font-size: 1.1rem;\n    font-weight: 500;\n    color: #b8954a;\n    flex-shrink: 0;\n    min-width: 2.2rem;\n  }\n  .zh-ritual__step strong {\n    color: #241610;\n    font-weight: 500;\n  }\n\n  /* Quote */\n  .zh-ritual__quote-wrap {\n    max-width: 720px;\n    margin: 0 auto;\n    padding: clamp(2rem, 5vw, 3.5rem) 1.5rem;\n    text-align: center;\n  }\n  .zh-ritual__quote {\n    font-family: 'Cormorant Garamond', Georgia, serif;\n    font-size: clamp(1.4rem, 3vw, 1.9rem);\n    font-style: italic;\n    color: #241610;\n    line-height: 1.45;\n    margin: 0 0 1rem;\n  }\n  .zh-ritual__quote-author {\n    font-family: 'Jost', sans-serif;\n    font-size: 0.72rem;\n    font-weight: 500;\n    letter-spacing: 0.2em;\n    text-transform: uppercase;\n    color: #b8954a;\n  }\n\n  /* CTA */\n  .zh-ritual__cta-wrap {\n    text-align: center;\n    padding: clamp(2rem, 4vw, 3rem) 1.5rem 4rem;\n  }\n  .zh-ritual__cta {\n    display: inline-flex;\n    align-items: center;\n    gap: 0.75rem;\n    padding: 1rem 2.5rem;\n    border: 1px solid #b8954a;\n    background: transparent;\n    color: #b8954a;\n    font-family: 'Jost', sans-serif;\n    font-size: 0.68rem;\n    font-weight: 500;\n    letter-spacing: 0.22em;\n    text-transform: uppercase;\n    text-decoration: none;\n    transition: all 0.35s ease;\n  }\n  .zh-ritual__cta:hover {\n    background: #b8954a;\n    color: #f5f0e8;\n  }\n\n  /* Divider */\n  .zh-ritual__divider {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 1.5rem;\n  }\n  .zh-ritual__divider-line {\n    height: 1px;\n    background: linear-gradient(90deg, transparent 0%, #b8954a 20%, #b8954a 80%, transparent 100%);\n    opacity: 0.2;\n  }\n</style>\n<div class=\"zh-ritual\">\n<!-- Hero --><header class=\"zh-ritual__hero\"><span class=\"zh-ritual__eyebrow\">Le Rituel</span>\n<h1 class=\"zh-ritual__title\">Du rituel à <em>ta tasse.</em>\n</h1>\n<p class=\"zh-ritual__lead\">Contrairement à l'espresso, le café épicé marocain se prépare en infusion lente. Un geste simple, un résultat d'une profondeur aromatique rare.</p>\n</header><!-- Split 1 : Image gauche / Texte droite -->\n<div class=\"zh-ritual__split\">\n<div class=\"zh-ritual__image\"><img alt=\"Tasse de café épicé marocain, infusion traditionnelle\"></div>\n<div class=\"zh-ritual__text\">\n<h2>Une infusion <em>pas une extraction.</em>\n</h2>\n<p>Le café beldi ne se presse pas. Il s'infuse, comme un thé, laissant le temps aux épices entières de libérer leurs huiles essentielles dans l'eau frémissante.</p>\n<p>Chaque sachet Zahowa contient 12 g d'Arabica d'Éthiopie — torréfié lentement à Montpellier — associé à une composition d'épices dont la recette a été affinée pendant des mois.</p>\n</div>\n</div>\n<div class=\"zh-ritual__divider\">\n<div class=\"zh-ritual__divider-line\"><br></div>\n</div>\n<!-- Split 2 : Texte gauche / Image droite -->\n<div class=\"zh-ritual__split zh-ritual__split--reverse\">\n<div class=\"zh-ritual__image\"><img alt=\"Épices entières : cardamome, cannelle, safran\"></div>\n<div class=\"zh-ritual__text\">\n<h2>Les trois gestes <em>du maître.</em>\n</h2>\n<ul class=\"zh-ritual__steps\">\n<li class=\"zh-ritual__step\">\n<span class=\"zh-ritual__step-num\">01</span> <span><strong>Infuser</strong> — un sachet dans l'eau frémissante (90–95 °C).</span>\n</li>\n<li class=\"zh-ritual__step\">\n<span class=\"zh-ritual__step-num\">02</span> <span><strong>Patienter</strong> — 4 minutes d'extraction douce. Pas une seconde de moins.</span>\n</li>\n<li class=\"zh-ritual__step\">\n<span class=\"zh-ritual__step-num\">03</span> <span><strong>Déguster</strong> — les épices se révèlent en bouche, le café enveloppe.</span>\n</li>\n</ul>\n</div>\n</div>\n<div class=\"zh-ritual__divider\">\n<div class=\"zh-ritual__divider-line\"><br></div>\n</div>\n<!-- Split 3 : Image gauche / Texte droite -->\n<div class=\"zh-ritual__split\">\n<div class=\"zh-ritual__image\"><img alt=\"Moment de dégustation en couple, riad marocain\"></div>\n<div class=\"zh-ritual__text\">\n<h2>Un moment <em>à partager.</em>\n</h2>\n<p>Au Maroc, le café se boit à deux. Debout, assis, à l'ombre d'un patio ou au soleil d'une terrasse — le temps s'arrête le temps d'une tasse.</p>\n<p>Zahowa naît de cette conviction : le café n'est pas une marchandise, c'est un <strong>rituel de présence</strong>. Un geste qu'on offre, qu'on partage, qu'on transmet.</p>\n</div>\n</div>\n<!-- Citation -->\n<div class=\"zh-ritual__quote-wrap\">\n<blockquote class=\"zh-ritual__quote\">« Le café est un rituel qui mérite le temps qu'on lui consacre. »</blockquote>\n<cite class=\"zh-ritual__quote-author\">— Fondatrice, Zahowa</cite>\n</div>\n<!-- CTA -->\n<div class=\"zh-ritual__cta-wrap\"><a href=\"/collections/all\" class=\"zh-ritual__cta\">Découvrir les créations</a></div>\n</div>",
